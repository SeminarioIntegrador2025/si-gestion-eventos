@model si_td_gestion_eventos.Models.ViewModels.EventoVM

@{
    ViewData["Title"] = "Confirmar Cancelación";
}

<h2>@ViewData["Title"]</h2>
<p class="text-danger">¿Estás seguro de que querés cancelar el siguiente evento?</p>

<hr />

<div>
    <h4>Datos del Evento a Cancelar</h4>
    <dl class="row">
        <dt class="col-sm-3">Cliente</dt>
        <dd class="col-sm-10">@Model.ClienteNombreCompleto</dd>

        <dt class="col-sm-3">Tipo de Evento</dt>
        <dd class="col-sm-9">@Model.Tipo</dd>

        <dt class="col-sm-3">Fecha del Contrato</dt>
        <dd class="col-sm-9">@Model.FechaContrato.ToShortDateString()</dd>

        <dt class="col-sm-3">Fecha de Inicio</dt>
        <dd class="col-sm-9">@Model.Inicio.ToShortDateString()</dd>

        <dt class="col-sm-3">Cantidad de Personas</dt>
        <dd class="col-sm-9">@Model.CantidadPersonas</dd>

        <dt class="col-sm-3">Estado Actual</dt>
        <dd class="col-sm-9">@Model.Estado</dd>
    </dl>
</div>

<hr />

<form asp-action="Cancel" method="post">
    <input type="hidden" asp-for="EventoId" />

    <button type="submit" class="btn btn-danger">Confirmar Cancelación</button>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</form>
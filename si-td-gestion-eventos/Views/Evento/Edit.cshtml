@model si_td_gestion_eventos.Models.ViewModels.EventoVM

@{
    ViewData["Title"] = "Editar Evento";
}

<div class="container-fluid">
    <div class="page-header mb-4">
        <h2 class="page-title">
            <i class="fas fa-edit me-3 text-primary"></i>Editar Evento
        </h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Evento" asp-action="Index">Eventos</a></li>
                <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.EventoId">Detalles</a></li>
                <li class="breadcrumb-item active">Editar</li>
            </ol>
        </nav>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger shadow-sm" role="alert">
                    <h6 class="alert-heading fw-bold">
                        <i class="fas fa-exclamation-triangle me-2"></i>Atención
                    </h6>
                    <ul class="mb-0 small">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-pen-to-square me-2"></i>Datos del Evento
                    </h5>
                </div>

                <form asp-action="Edit" method="post" novalidate id="formEditarEvento">
                    <div class="card-body">
                        <input type="hidden" asp-for="EventoId" />

                        <partial name="_EventoEditForm" model="Model" />

                        <div class="row mt-3">
                            <div class="col-md-6">
                                <label asp-for="HoraInicio" class="form-label fw-semibold">Hora de Inicio</label>
                                <input asp-for="HoraInicio" class="form-control" type="time" />
                                <span asp-validation-for="HoraInicio" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="HoraFin" class="form-label fw-semibold">Hora de Fin</label>
                                <input asp-for="HoraFin" class="form-control" type="time" />
                                <span asp-validation-for="HoraFin" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="card-footer bg-transparent d-flex justify-content-between align-items-center">
                        <a asp-action="Details" asp-route-id="@Model.EventoId" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Cancelar
                        </a>
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="fas fa-save me-2"></i>Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {

            // --- BLOQUE 1: Formato Visual de Cédula ---
            $('#ResponsableCedula').on('input', function() {
                let value = this.value.replace(/[^\d]/g, ''); // Solo números
                if (value.length > 8) {
                    value = value.substring(0, 8);
                }
                if (value.length >= 2) {
                    // Formato 1.234.567-8
                    value = value.substring(0, value.length - 1).replace(/(\d)(?=(\d{3})+(?!\d))/g, '$1.') + '-' + value.substring(value.length - 1);
                }
                this.value = value;
            });

            // --- BLOQUE 2: Autocompletado por CI (Lógica AJAX) ---
            const $inputCI = $("#ResponsableCedula");
            const $inputNombre = $("#ResponsableNombre");
            const $inputTel = $("#ResponsableTelefono");

            $inputCI.on("blur", function () {
                let cedula = $(this).val();

                // Si está vacío, no hacemos nada
                if (!cedula) return;

                // Feedback visual (opacidad mientras busca)
                $inputCI.addClass("opacity-50");

                $.ajax({
                    url: '@Url.Action("BuscarPorCI", "Cliente")', // Llama al método en ClienteController
                    type: 'GET',
                    data: { ci: cedula },
                    success: function (response) {
                        if (response.success) {
                            // Encontrado: Rellenamos campos
                            $inputNombre.val(response.nombre);
                            $inputTel.val(response.telefono);

                            // Efecto visual verde (Feedback de éxito)
                            $inputNombre.addClass("is-valid");
                            $inputTel.addClass("is-valid");

                            // Quitamos el verde después de 1.5 seg
                            setTimeout(() => {
                                $inputNombre.removeClass("is-valid");
                                $inputTel.removeClass("is-valid");
                            }, 1500);
                        }
                    },
                    error: function () {
                        // Si no encuentra, simplemente dejamos que el usuario escriba
                        // (Opcional: puedes mostrar un pequeño mensaje en consola)
                        console.log("Cliente no encontrado, manteniendo datos manuales.");
                    },
                    complete: function () {
                        // Quitamos el feedback visual de carga
                        $inputCI.removeClass("opacity-50");
                    }
                });
            });
        });
    </script>
}
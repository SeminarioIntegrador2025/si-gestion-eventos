@model si_td_gestion_eventos.Models.ViewModels.EventoVM
@using si_td_gestion_eventos.Models.Enums

@{
    ViewData["Title"] = "Editar Evento";
}

<div class="container-fluid">
    <div class="page-header mb-4">
        <h2 class="page-title">
            <i class="fas fa-edit me-3 text-primary"></i>Editar Evento
        </h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Evento" asp-action="Index">Eventos</a></li>
                <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.EventoId">Detalles</a></li>
                <li class="breadcrumb-item active">Editar</li>
            </ol>
        </nav>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
            {
                <div class="alert alert-warning alert-dismissible fade show shadow-sm" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>Error al guardar.</strong> Por favor, revise los errores marcados en el formulario.
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-pen-to-square me-2"></i>Datos del Evento
                    </h5>
                </div>

                <form asp-action="Edit" method="post" novalidate id="formEditarEvento">
                    <div class="card-body">
                        <input type="hidden" asp-for="EventoId" />
                        
                        <partial name="_EventoEditForm" model="Model" />
                    </div>

                    <div class="card-footer bg-transparent d-flex justify-content-between align-items-center">
                        <a asp-action="Details" asp-route-id="@Model.EventoId" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Cancelar
                        </a>
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="fas fa-save me-2"></i>Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {

            $.validator.methods.range = function(value, element, param) {
                var globalizedValue = value.replace(",", ".");
                return this.optional(element) || (globalizedValue >= param[0] && globalizedValue <= param[1]);
            };

            $.validator.methods.number = function(value, element) {
                return this.optional(element) || /^-?(?:\d+|\d{1,3}(?:[\s\.,]\d{3})+)(?:[\.,]\d+)?$/.test(value);
            };

            //  MENSAJES DE VALIDACIÓN 
            if ($.validator && $.validator.messages) {
                $.extend($.validator.messages, {
                    required: "Este campo es obligatorio.",
                    email: "Por favor, ingrese un correo electrónico válido.",
                    url: "Por favor, ingrese una URL válida.",
                    date: "Por favor, ingrese una fecha válida.",
                    dateISO: "Por favor, ingrese una fecha válida (ISO).",
                    number: "Por favor, ingrese un número válido.",
                    digits: "Por favor, ingrese solo dígitos.",
                    creditcard: "Por favor, ingrese un número de tarjeta válido.",
                    equalTo: "Por favor, ingrese el mismo valor nuevamente.",
                    maxlength: $.validator.format("Por favor, no ingrese más de {0} caracteres."),
                    minlength: $.validator.format("Por favor, ingrese al menos {0} caracteres."),
                    rangelength: $.validator.format("Por favor, ingrese un valor entre {0} y {1} caracteres."),
                    range: $.validator.format("Por favor, ingrese un valor entre {0} y {1}."),
                    max: $.validator.format("Por favor, ingrese un valor menor o igual a {0}."),
                    min: $.validator.format("Por favor, ingrese un valor mayor o igual a {0}.")
                });
            }

            $('#CantidadPersonas').on('blur', function() {
                const val = parseInt($(this).val());
                const $error = $(this).siblings('.text-danger');
                
                if (val < 50) {
                    $(this).addClass('is-invalid');
                    $error.text('Se necesitan al menos 50 personas para el evento.');
                } else if (val > 400) {
                    $(this).addClass('is-invalid');
                    $error.text('El salón no permite más de 400 personas.');
                } else {
                    $(this).removeClass('is-invalid');
                    $error.text('');
                }
            });

            $('#MontoAireAcondicionado').on('blur', function() {
                const val = parseFloat($(this).val());
                const $error = $(this).closest('.form-group').find('.text-danger');
                
                if (val < 0) {
                    $(this).addClass('is-invalid');
                    $error.text('El monto no puede ser negativo.');
                } else {
                    $(this).removeClass('is-invalid');
                    $error.text('');
                }
            });

            // --- BLOQUE: Formato Visual de Cédula ---
            $('#ResponsableCedula').on('input', function() {
                let value = this.value.replace(/[^\d]/g, '');
                if (value.length > 8) {
                    value = value.substring(0, 8);
                }
                if (value.length >= 2) {
                    value = value.substring(0, value.length - 1).replace(/(\d)(?=(\d{3})+(?!\d))/g, '$1.') + '-' + value.substring(value.length - 1);
                }
                this.value = value;
            });

            // --- BLOQUE: Autocompletado por CI (Lógica AJAX) ---
            const $inputCI = $("#ResponsableCedula");
            const $inputNombre = $("#ResponsableNombre");
            const $inputTel = $("#ResponsableTelefono");

            $inputCI.on("blur", function () {
                let cedula = $(this).val();
                if (!cedula) return;

                $inputCI.addClass("opacity-50");

                $.ajax({
                    url: '@Url.Action("BuscarPorCI", "Cliente")',
                    type: 'GET',
                    data: { ci: cedula },
                    success: function (response) {
                        if (response.success) {
                            $inputNombre.val(response.nombre);
                            $inputTel.val(response.telefono);

                            $inputNombre.addClass("is-valid");
                            $inputTel.addClass("is-valid");

                            setTimeout(() => {
                                $inputNombre.removeClass("is-valid");
                                $inputTel.removeClass("is-valid");
                            }, 1500);
                        }
                    },
                    error: function () {
                        console.log("Cliente no encontrado, manteniendo datos manuales.");
                    },
                    complete: function () {
                        $inputCI.removeClass("opacity-50");
                    }
                });
            });
        });
    </script>
}
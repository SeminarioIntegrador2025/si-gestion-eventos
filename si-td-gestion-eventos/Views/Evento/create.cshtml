@model si_td_gestion_eventos.Models.ViewModels.EventoVM

@{
    ViewData["Title"] = "Crear Nuevo Evento";
}

<div class="container-fluid">
    <div class="page-header mb-4">
        <h2 class="page-title">
            <i class="fas fa-calendar-plus me-3 text-success"></i>Nuevo Evento
        </h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Evento" asp-action="Index">Eventos</a></li>
                <li class="breadcrumb-item active">Nuevo</li>
            </ol>
        </nav>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-calendar-plus me-2"></i>Información del Evento
                    </h5>
                </div>

                <form asp-action="Create" method="post" novalidate id="formCrearEvento">
                    <div class="card-body">
                        @* IMPORTANTE: Dentro de este Parcial, asegúrate de que los inputs de hora 
                           NO tengan un value predefinido si quieres ver el --:--
                        *@
                        <partial name="_EventoCreateForm" model="Model" />
                    </div>

                    <div class="card-footer bg-transparent d-flex justify-content-between align-items-center py-3">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Volver al Listado
                        </a>
                        <button type="submit" class="btn btn-success btn-lg px-5 shadow-sm">
                            <i class="fas fa-save me-2"></i>Crear Evento
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {

            // 1. Formato visual de la Cédula Uruguaya (mientras escribes: 1.234.567-8)
            $('#ResponsableCedula').on('input', function() {
                let value = this.value.replace(/[^\d]/g, '');
                if (value.length > 8) {
                    value = value.substring(0, 8);
                }
                if (value.length >= 2) {
                    value = value.substring(0, value.length - 1).replace(/(\d)(?=(\d{3})+(?!\d))/g, '$1.') + '-' + value.substring(value.length - 1);
                }
                this.value = value;
            });

            // 2. Autocompletado de Responsable al cambiar la Cédula
            $('#ResponsableCedula').on('change', function () {
                var ciIngresada = $(this).val();

                if (ciIngresada && ciIngresada.length > 0) {
                    // Feedback visual de carga
                    $('#ResponsableNombre, #ResponsableTelefono').attr('placeholder', 'Buscando cliente...');

                    $.ajax({
                        url: '/Cliente/BuscarPorCI',
                        type: 'GET',
                        data: { ci: ciIngresada },
                        success: function (data) {
                            if (data.success) {
                                $('#ResponsableNombre').val(data.nombre);
                                $('#ResponsableTelefono').val(data.telefono);

                                // Feedback visual de éxito
                                $('#ResponsableNombre, #ResponsableTelefono').addClass('is-valid');
                                setTimeout(() => $('.is-valid').removeClass('is-valid'), 2000);
                            }
                        },
                        error: function () {
                            console.log("Cédula no encontrada. Ingrese los datos manualmente.");
                        },
                        complete: function() {
                             $('#ResponsableNombre, #ResponsableTelefono').attr('placeholder', '');
                        }
                    });
                }
            });

            // 3. Validación de Negocio: Advertencia de Eventos < 48hs
            $("#formCrearEvento").on("submit", function(e) {
                const fechaVal = $("#FechaInicio").val();
                const horaVal = $("#HoraInicio").val();

                if(!fechaVal || !horaVal) return;

                const fechaInicio = new Date(fechaVal + "T" + horaVal);
                const costoAlquiler = parseFloat($("#CostoAlquiler").val()) || 0;
                const montoAire = parseFloat($("#MontoAireAcondicionado").val()) || 0;
                const montoReserva = parseFloat($("#MontoReserva").val()) || 0;

                const costoTotal = costoAlquiler + montoAire;
                const ahora = new Date();
                const deadline48hs = new Date(ahora.getTime() + 48 * 60 * 60 * 1000);

                const esDentroDe48Hs = (fechaInicio > ahora && fechaInicio < deadline48hs);
                const esPagoParcial = montoReserva < costoTotal;

                if (esDentroDe48Hs && esPagoParcial) {
                    const mensaje = "⚠️ ATENCIÓN: \n\n" +
                                    "Este evento está programado para realizarse en menos de 48 horas.\n" +
                                    "Sin embargo, el monto ingresado es inferior al costo total.\n\n" +
                                    "¿Desea confirmar la creación del evento de todas formas?";

                    if (!confirm(mensaje)) {
                        e.preventDefault();
                    }
                }
            });

        });
    </script>
}
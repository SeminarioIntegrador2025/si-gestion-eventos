@model si_td_gestion_eventos.Entities.Evento
@using si_td_gestion_eventos.Models.Enums

@{
    ViewData["Title"] = "Nuevo Evento";
}

<h2>Nuevo Evento</h2>
<form asp-action="Create" method="post">

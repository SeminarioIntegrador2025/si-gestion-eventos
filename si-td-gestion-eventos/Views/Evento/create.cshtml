@model si_td_gestion_eventos.Models.ViewModels.EventoVM

@{
    ViewData["Title"] = "Crear Nuevo Evento";
}

<h2 class="mb-4">Nuevo Evento</h2>

<form asp-action="Create" method="post">
    <partial name="_EventoForms" model="Model" />
    <div class="mt-4">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-circle"></i> Crear Evento
        </button>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-x-circle"></i> Volver
        </a>
    </div>
</form>

@* validación del lado del cliente *@
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
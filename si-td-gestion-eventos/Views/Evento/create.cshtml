@model si_td_gestion_eventos.Models.ViewModels.EventoVM

@{
    ViewData["Title"] = "Crear Nuevo Evento";
}

<div class="container-fluid">
    <div class="page-header mb-4">
        <h2 class="page-title">
            <i class="fas fa-calendar-plus me-3 text-success"></i>Nuevo Evento
        </h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Evento" asp-action="Index">Eventos</a></li>
                <li class="breadcrumb-item active">Nuevo</li>
            </ol>
        </nav>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-calendar-plus me-2"></i>Información del Evento
                    </h5>
                </div>

                    <form asp-action="Create" method="post" novalidate>
                        <partial name="_EventoCreateForm" model="Model" />
                        
                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Volver
                            </a>
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="fas fa-check-circle me-2"></i>Crear Evento
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {

            // Apunta al ID específico de este campo
            $('#ResponsableCedula').on('input', function() {

                let value = this.value.replace(/[^\d]/g, '');

                // Trunca a 8 dígitos (X.XXX.XXX-N)
                if (value.length > 8) {
                    value = value.substring(0, 8);
                }

                // Aplica el formato
                if (value.length >= 2) {
                    value = value.substring(0, value.length - 1).replace(/(\d)(?=(\d{3})+(?!\d))/g, '$1.') + '-' + value.substring(value.length - 1);
                }

                this.value = value;
            });

        });
    </script>
}
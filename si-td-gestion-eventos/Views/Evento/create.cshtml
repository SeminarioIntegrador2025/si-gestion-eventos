@model si_td_gestion_eventos.Models.ViewModels.EventoVM

@{
    ViewData["Title"] = "Crear Nuevo Evento";
}

<div class="container-fluid">
    <div class="page-header mb-4">
        <h2 class="page-title">
            <i class="fas fa-calendar-plus me-3 text-success"></i>Nuevo Evento
        </h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Evento" asp-action="Index">Eventos</a></li>
                <li class="breadcrumb-item active">Nuevo</li>
            </ol>
        </nav>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-calendar-plus me-2"></i>Información del Evento
                    </h5>
                </div>

                <form asp-action="Create" method="post" novalidate>
                    <div class="card-body">
                        <partial name="_EventoCreateForm" model="Model" />
                    </div>

                    <div class="card-footer bg-light d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Volver
                        </a>
                        <button type="submit" class="btn btn-success btn-lg">
                            <i class="fas fa-check-circle me-2"></i>Crear Evento
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
    
            $('#ResponsableCedula').on('input', function() {
                let value = this.value.replace(/[^\d]/g, '');
                if (value.length > 8) {
                    value = value.substring(0, 8);
                }
                if (value.length >= 2) {
                    value = value.substring(0, value.length - 1).replace(/(\d)(?=(\d{3})+(?!\d))/g, '$1.') + '-' + value.substring(value.length - 1);
                }
                this.value = value;
            });

            const fechaInicioInput = $("#FechaInicio");
            const costoAlquilerInput = $("#CostoAlquiler");
            const horaInicioInput = $("#HoraInicio"); 
            const montoAireInput = $("#MontoAire");
            const montoReservaInput = $("#MontoReserva");
            const montoReservaLabel = $("#MontoReservaLabel");

            // Salir si los elementos no existen (medida de seguridad)
           if (!fechaInicioInput.length || !horaInicioInput.length || !costoAlquilerInput.length || !montoAireInput.length || !montoReservaInput.length || !montoReservaLabel.length) {
            console.warn("Script de 48hs: No se encontraron todos los IDs necesarios.");
            return;
        }

            
            const labelOriginal = montoReservaLabel.text();

          
               function revisarLogica48Hs() {

                const costoAlquiler = parseFloat(costoAlquilerInput.val()) || 0;
                const montoAire = parseFloat(montoAireInput.val()) || 0;
                const fechaVal = fechaInicioInput.val(); 
                const horaVal = horaInicioInput.val();   


                if (!fechaVal || !horaVal) {

                    montoReservaLabel.text(labelOriginal);
                    montoReservaInput.prop("readonly", false);
                    return; 
                }


                const fechaInicio = new Date(fechaVal + "T" + horaVal);


                const ahora = new Date();
                const deadline48hs = new Date(ahora.getTime() + 48 * 60 * 60 * 1000);

                if (fechaInicio > ahora && fechaInicio < deadline48hs) {

                    const costoTotal = costoAlquiler + montoAire;
                    montoReservaLabel.text("Monto Total (Pago Requerido)");
                    montoReservaInput.val(costoTotal.toFixed(2));
                    montoReservaInput.prop("readonly", true);

                } else {

                    montoReservaLabel.text(labelOriginal);
                    montoReservaInput.prop("readonly", false);
                }
            }

            fechaInicioInput.on("change", revisarLogica48Hs);
            horaInicioInput.on("change", revisarLogica48Hs); 
            costoAlquilerInput.on("input", revisarLogica48Hs);
            montoAireInput.on("input", revisarLogica48Hs);

          
            revisarLogica48Hs();
        });
    </script>
}
@using si_td_gestion_eventos.Models.Enums
@model si_td_gestion_eventos.Models.ViewModels.EventoVM
@using si_td_gestion_eventos.Services.Contracts
@inject IServicioEsencialService _servicioEsencialService

@{
    ViewData["Title"] = $"{Model.Tipo} de {Model.ClienteNombreCompleto}";

    // Cálculo local para visualización rápida en la vista
    // Nota: Model.TotalPagado viene de la BD ya corregido (sin los pagos anulados)
    float costoTotal = (float)(Model.CostoAlquiler + (Model.MontoAireAcondicionado ?? 0));
    float saldo = costoTotal - (float)Model.TotalPagado;
}

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Ok"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="fa-solid fa-champagne-glasses me-2 text-primary"></i>
            @Model.Tipo de @Model.ClienteNombreCompleto
        </h1>
        <p class="text-muted mb-0">
            <i class="fa-solid fa-calendar me-1"></i>
            @Model.Inicio.ToString("dddd, dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-ES"))
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Reporte" asp-action="DescargarPdfIndividual" asp-route-id="@Model.EventoId" target="_blank" class="btn btn-danger">
            <i class="fa-solid fa-file-pdf me-2"></i>Reporte PDF
        </a>
        <a asp-action="Edit" asp-route-id="@Model.EventoId" class="btn btn-primary">
            <i class="fa-solid fa-pen me-2"></i>Editar
        </a>
        <a asp-controller="Pago" asp-action="Create" asp-route-eventoId="@Model.EventoId" class="btn btn-success">
            <i class="fa-solid fa-plus me-2"></i>Agregar Pago
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-2"></i>Volver
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">

        <div class="detail-section section-financial">
            <div class="detail-section-title">
                <i class="fa-solid fa-dollar-sign text-success"></i>
                Información Financiera
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <small class="text-muted d-block">Costo del Alquiler</small>
                    <strong class="fs-5">@Model.CostoAlquiler.ToString("C")</strong>
                </div>
                <div class="col-md-6 mb-3">
                    <small class="text-muted d-block">Monto de Reserva</small>
                    <strong class="fs-5">@Model.MontoReserva.ToString("C")</strong>
                </div>
                <div class="col-md-6 mb-3">
                    <small class="text-muted d-block">Costo Aire Acondicionado</small>
                    <strong class="fs-5">@(Model.MontoAireAcondicionado?.ToString("C") ?? "No incluido")</strong>
                </div>
                <div class="col-md-6 mb-3">
                    <small class="text-muted d-block">Estado</small>
                    <span class="badge bg-info fs-6">@Model.Estado</span>
                </div>
            </div>
            <hr />
            <div class="row">
                <div class="col-md-6">
                    <small class="text-muted d-block">Total Pagado (Real)</small>
                    <strong class="fs-4 text-success">@Model.TotalPagado.ToString("C")</strong>
                </div>
                <div class="col-md-6">
                    <small class="text-muted d-block">Saldo Restante</small>
                    <strong class="fs-4 @(saldo > 0 ? "text-danger" : "text-success")">
                        @saldo.ToString("C")
                    </strong>
                </div>
                <div class="mt-3 text-end">
                    <a asp-controller="Pago" asp-action="Index" asp-route-eventoId="@Model.EventoId" class="btn btn-outline-primary">
                        <i class="fa-solid fa-list me-2"></i>Ver Lista Detallada de Pagos
                    </a>
                </div>
            </div>
        </div>

     

        <div class="detail-section section-observaciones mt-4">
            <div class="detail-section-title">
                <i class="fa-solid fa-file-lines text-primary"></i>
                Observaciones del Evento
                <a asp-action="Edit" asp-route-id="@Model.EventoId" class="btn btn-sm btn-outline-primary ms-auto">
                    <i class="fa-solid fa-pen me-1"></i>Editar
                </a>
            </div>
            <p class="mb-0">
                @if (!string.IsNullOrEmpty(Model.Observaciones))
                {
                    @Model.Observaciones
                }
                else
                {
                    <span class="text-muted fst-italic">Sin observaciones</span>
                }
            </p>
        </div>

        <div class="detail-section section-client">
            <div class="detail-section-title">
                <i class="fa-solid fa-user text-muted"></i>
                Información del Cliente Contratante
            </div>
            <div class="row">
                <div class="col-md-6 mb-2">
                    <small class="text-dark fw-semibold d-block">Cliente</small>
                    <strong>@Model.ClienteNombreCompleto</strong>
                </div>
                <div class="col-md-6 mb-2">
                    <small class="text-dark fw-semibold d-block">Tipo de Cliente</small>
                    <strong>@(Model.TipoCli == TipoCliente.PersonaFisica ? "Persona Física" : "Persona Jurídica")</strong>
                </div>
                <div class="col-md-6 mb-2">
                    <small class="text-dark fw-semibold d-block">Teléfono</small>
                    <strong>@Model.ClienteTelefono</strong>
                </div>
                <div class="col-md-6 mb-2">
                    <small class="text-dark fw-semibold d-block">Domicilio</small>
                    <strong>@Model.ClienteDomicilio</strong>
                </div>
            </div>

            <hr class="my-3" />

            <div class="detail-section-title mb-3">
                <i class="fa-solid fa-user-tie text-muted"></i>
                Responsable del Salón
            </div>
            <div class="row">
                <div class="col-md-4 mb-2">
                    <small class="text-dark fw-semibold d-block">Nombre</small>
                    <strong>@Model.ResponsableNombre</strong>
                </div>
                <div class="col-md-4 mb-2">
                    <small class="text-dark fw-semibold d-block">Teléfono</small>
                    <strong>@Model.ResponsableTelefono</strong>
                </div>
                <div class="col-md-4 mb-2">
                    <small class="text-dark fw-semibold d-block">Cédula</small>
                    <strong>@Model.ResponsableCedula</strong>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">

        <div class="detail-section section-dates">
            <div class="detail-section-title">
                <i class="fa-solid fa-clock text-warning"></i>
                Fechas y Horarios
            </div>
            <div class="mb-3">
                <small class="text-muted d-block">Fecha del Contrato</small>
                <strong>@Model.FechaContrato.ToLongDateString()</strong>
            </div>
            <div class="mb-3">
                <small class="text-muted d-block">Fecha de Inicio</small>
                <strong>@Model.Inicio.ToLongDateString()</strong>
            </div>
            <div class="mb-3">
                <small class="text-muted d-block">Fecha de Fin</small>
                <strong>@Model.Fin.ToLongDateString()</strong>
            </div>
            <div class="mb-0">
                <small class="text-muted d-block">Horario del Evento</small>
                <strong>De @Model.HoraInicio.ToString("hh\\:mm") a @Model.HoraFin.ToString("hh\\:mm")</strong>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">
                    <i class="fa-solid fa-info-circle me-2"></i>
                    Otros Datos
                </h6>
            </div>
            <div class="card-body">
                <div class="mb-2">
                    <small class="text-muted d-block">Tipo de Evento</small>
                    <strong>@Model.Tipo</strong>
                </div>
                <div class="mb-0">
                    <small class="text-muted d-block">Cantidad de Personas</small>
                    <strong>@Model.CantidadPersonas personas</strong>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fa-solid fa-list-check me-2"></i>
                    Servicios Esenciales
                </h5>
            </div>
            <div class="card-body">
                @{
                    var listaServicios = await _servicioEsencialService.GetByEventoIdAsync(Model.EventoId);
                }
                <partial name="_GestorServicios" model="listaServicios" />
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        @if (Model.FianzaId != null)
        {
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">
                        <i class="fa-solid fa-shield-alt me-2"></i>
                        Fianza Registrada
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <small class="text-dark fw-semibold d-block">Fecha de Registro</small>
                            <strong>@Model.DetalleFianza.FechaRegistro.ToShortDateString()</strong>
                        </div>
                        <div class="col-md-3">
                            <small class="text-dark fw-semibold d-block">Monto de la Fianza</small>
                            <strong class="text-success">@Model.DetalleFianza.Monto.ToString("C2")</strong>
                        </div>
                        <div class="col-md-3">
                            <small class="text-dark fw-semibold d-block">Estado de la Fianza</small>
                            <span class="badge bg-info">@Model.DetalleFianza.Estado</span>
                        </div>
                        <div class="col-md-3 text-end">
                            <a asp-controller="Fianza"
                               asp-action="Details"
                               asp-route-id="@Model.FianzaId"
                               asp-route-returnUrl="@Url.Action("Details", "Evento", new { id = Model.EventoId })"
                               class="btn btn-outline-warning">
                                <i class="fa-solid fa-eye me-2"></i>Ver Detalles
                            </a>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.DetalleFianza.Observaciones))
                    {
                        <hr />
                        <small class="text-dark fw-semibold d-block">Observaciones</small>
                        <p class="mb-0">@Model.DetalleFianza.Observaciones</p>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-warning border-0">
                <i class="fa-solid fa-info-circle me-2"></i>
                <strong>No hay fianza registrada para este evento.</strong>
                <a asp-controller="Fianza" asp-action="Create" asp-route-eventoId="@Model.EventoId" class="btn btn-warning btn-sm ms-3">
                    <i class="fa-solid fa-plus me-1"></i>Registrar Fianza
                </a>
            </div>
        }
    </div>
</div>
@using si_td_gestion_eventos.Models.Enums
@model si_td_gestion_eventos.Models.ViewModels.EventoVM
@using si_td_gestion_eventos.Services.Contracts
@inject IServicioEsencialService _servicioEsencialService

@{
    ViewData["Title"] = $"{Model.Tipo} de {Model.ClienteNombreCompleto}";

    // Cálculos de visualización rápida
    float costoTotal = (float)(Model.CostoAlquiler + (Model.MontoAireAcondicionado ?? 0));
    float saldo = costoTotal - (float)Model.TotalPagado;

    // Color del estado
    string badgeClass = Model.Estado switch
    {
        EventoEstado.PendienteAdeudado => "bg-warning text-dark",
        EventoEstado.PendientePagado => "bg-success",
        EventoEstado.Realizado => "bg-info",
        EventoEstado.Cancelado => "bg-danger",
        EventoEstado.Reprogramado => "bg-primary",
        _ => "bg-secondary"
    };
}

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-check-circle me-2"></i>@TempData["Ok"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-circle-exclamation me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-start mb-4 gap-3">
    <div class="flex-grow-1">
        <h1 class="page-title mb-2">
            <i class="fa-solid fa-champagne-glasses me-2 text-primary"></i>
            @Model.Tipo de @Model.ClienteNombreCompleto
        </h1>
        <p class="text-muted mb-0">
            <i class="fa-solid fa-calendar me-1"></i>
            @Model.Inicio.ToString("dddd, dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-ES"))
        </p>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Reporte" asp-action="DescargarPdfIndividual" asp-route-id="@Model.EventoId" 
           class="btn btn-danger btn-sm" title="Descargar Reporte del Evento">
            <i class="fa-solid fa-file-pdf me-1"></i><span class="d-none d-md-inline"> Reporte PDF</span>
        </a>

        <button type="button" class="btn btn-warning text-dark btn-sm" 
                data-bs-toggle="modal" data-bs-target="#modalReprogramar" 
                title="Reprogramar Fecha">
            <i class="fa-solid fa-clock-rotate-left me-1"></i><span class="d-none d-md-inline">Reprogramar</span>
        </button>

        <a asp-action="Edit" asp-route-id="@Model.EventoId" class="btn btn-primary btn-sm">
            <i class="fa-solid fa-pen me-1"></i><span class="d-none d-md-inline">Editar</span>
        </a>

        @* LÓGICA CONDICIONAL PARA BOTÓN DE PAGO *@
        @if (Model.PermiteAgregarPago)
        {
            <a asp-controller="Pago" asp-action="Create" asp-route-eventoId="@Model.EventoId" 
               class="btn btn-success btn-sm">
                <i class="fa-solid fa-plus me-1"></i><span class="d-none d-md-inline">Agregar Pago</span>
            </a>
        }
        else if (Model.Estado == EventoEstado.Cancelado)
        {
            <button type="button" class="btn btn-secondary btn-sm" disabled 
                    title="No se pueden agregar pagos a eventos cancelados">
                <i class="fa-solid fa-ban me-1"></i><span class="d-none d-md-inline">Cancelado</span>
            </button>
        }
        else if (Model.Estado == EventoEstado.Realizado)
        {
            <a asp-controller="Pago" asp-action="Index" asp-route-eventoId="@Model.EventoId" 
               class="btn btn-outline-primary btn-sm">
                <i class="fa-solid fa-history me-1"></i><span class="d-none d-md-inline">Historial</span>
            </a>
        }
        else if (Model.Estado == EventoEstado.Reprogramado && Model.EsFechaIndefinida)
        {
            <a asp-action="Reprogramar" asp-route-id="@Model.EventoId" class="btn btn-warning btn-sm">
                <i class="fa-solid fa-calendar-plus me-1"></i><span class="d-none d-md-inline">Asignar Fecha</span>
            </a>
        }
        else if (Model.SaldoRestante <= 0)
        {
            <a asp-controller="Pago" asp-action="Index" asp-route-eventoId="@Model.EventoId" 
               class="btn btn-success btn-sm">
                <i class="fa-solid fa-check-circle me-1"></i><span class="d-none d-md-inline">Pagado</span>
            </a>
        }

        <a asp-action="Index" class="btn btn-secondary btn-sm">
            <i class="fa-solid fa-arrow-left"></i>
        </a>
    </div>
</div>

<div class="row g-3">
    <!-- COLUMNA IZQUIERDA -->
    <div class="col-lg-8">

        <!-- SECCIÓN: INFORMACIÓN FINANCIERA -->
        <div class="card shadow-sm mb-3 border-start border-4 border-success">
            <div class="card-header bg-success text-white">
                <h6 class="mb-0">
                    <i class="fa-solid fa-dollar-sign me-2"></i>Información Financiera
                </h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6 col-lg-3">
                        <small class="text-muted d-block mb-1">Costo del Alquiler</small>
                        <strong class="fs-6">@Model.CostoAlquiler.ToString("C")</strong>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <small class="text-muted d-block mb-1">Monto de Reserva</small>
                        <strong class="fs-6">@Model.MontoReserva.ToString("C")</strong>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <small class="text-muted d-block mb-1">Aire Acondicionado</small>
                        <strong class="fs-6">@(Model.MontoAireAcondicionado?.ToString("C") ?? "No incluido")</strong>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <small class="text-muted d-block mb-1">Estado Actual</small>
                        <span class="badge @badgeClass">@Model.Estado</span>
                    </div>
                </div>
                <hr class="my-3" />
                <div class="row g-3 align-items-center">
                    <div class="col-md-4">
                        <small class="text-muted d-block mb-1">Total Pagado</small>
                        <strong class="fs-5 text-success">@Model.TotalPagado.ToString("C")</strong>
                    </div>
                    <div class="col-md-4">
                        <small class="text-muted d-block mb-1">Saldo Restante</small>
                        <strong class="fs-5 @(saldo > 0.01f ? "text-danger" : "text-success")">
                            @saldo.ToString("C")
                        </strong>
                    </div>
                    <div class="col-md-4 text-md-end">
                        <a asp-controller="Pago" asp-action="Index" asp-route-eventoId="@Model.EventoId" 
                           class="btn btn-outline-primary btn-sm">
                            <i class="fa-solid fa-list me-1"></i>Ver Historial
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- SECCIÓN: OBSERVACIONES -->
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h6 class="mb-0">
                    <i class="fa-solid fa-file-lines me-2"></i>Observaciones
                </h6>
                <a asp-action="Edit" asp-route-id="@Model.EventoId" 
                   class="btn btn-sm btn-light">
                    <i class="fa-solid fa-pen me-1"></i>Editar
                </a>
            </div>
            <div class="card-body">
                <p class="mb-0" style="white-space: pre-line; word-break: break-word;">
                    @if (!string.IsNullOrEmpty(Model.Observaciones))
                    {
                        @Model.Observaciones
                    }
                    else
                    {
                        <span class="text-muted fst-italic">Sin observaciones registradas.</span>
                    }
                </p>
            </div>
        </div>

        <!-- SECCIÓN: INFORMACIÓN DEL CLIENTE -->
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-secondary text-white">
                <h6 class="mb-0">
                    <i class="fa-solid fa-users me-2"></i>Contactos
                </h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <h6 class="text-primary mb-2 border-bottom pb-2">Cliente Contratante</h6>
                        <div class="mb-2">
                            <small class="text-muted d-block">Nombre / Razón Social</small>
                            <strong class="d-block text-break">@Model.ClienteNombreCompleto</strong>
                        </div>
                        <div class="mb-2">
                            <small class="text-muted d-block">Tipo</small>
                            <span>@(Model.TipoCli == TipoCliente.PersonaFisica ? "Persona Física" : "Persona Jurídica")</span>
                        </div>
                        <div class="mb-2">
                            <small class="text-muted d-block">Teléfono</small>
                            <span class="d-block text-break">@Model.ClienteTelefono</span>
                        </div>
                        <div class="mb-0">
                            <small class="text-muted d-block">Domicilio</small>
                            <span class="d-block text-break">@Model.ClienteDomicilio</span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <h6 class="text-primary mb-2 border-bottom pb-2">Responsable del Salón</h6>
                        <div class="mb-2">
                            <small class="text-muted d-block">Nombre</small>
                            <strong class="d-block text-break">@Model.ResponsableNombre</strong>
                        </div>
                        <div class="mb-2">
                            <small class="text-muted d-block">Cédula</small>
                            <span>@Model.ResponsableCedula</span>
                        </div>
                        <div class="mb-0">
                            <small class="text-muted d-block">Teléfono</small>
                            <span class="d-block text-break">@Model.ResponsableTelefono</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- COLUMNA DERECHA -->
    <div class="col-lg-4">

        <!-- SECCIÓN: AGENDA -->
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-warning text-dark">
                <h6 class="mb-0">
                    <i class="fa-solid fa-clock me-2"></i>Agenda
                </h6>
            </div>
            <div class="card-body">

                @if (Model.Estado == EventoEstado.Reprogramado)
                {
                    <div class="text-center py-3">
                        <i class="fa-solid fa-calendar-question fa-3x text-warning mb-3"></i>
                        <h6 class="fw-bold">Fecha por Definir</h6>
                        <p class="small text-muted mb-3">
                            El cupo está libre. Defina una nueva fecha cuando el cliente confirme.
                        </p>

                        <button type="button" class="btn btn-warning fw-bold w-100 btn-sm" 
                                data-bs-toggle="modal" data-bs-target="#modalReprogramar">
                            <i class="fa-solid fa-calendar-check me-2"></i>Definir Fecha
                        </button>
                    </div>
                }
                else
                {
                    <div class="mb-3 pb-2 border-bottom">
                        <small class="text-muted d-block">Fecha del Evento</small>
                        <strong class="fs-6">@Model.Inicio.ToString("dd/MM/yyyy")</strong>
                    </div>
                    <div class="mb-3 pb-2 border-bottom">
                        <small class="text-muted d-block">Horario</small>
                        <strong>@Model.HoraInicio.ToString("hh\\:mm") - @Model.HoraFin.ToString("hh\\:mm")</strong>
                    </div>
                    <div class="mb-0">
                        <small class="text-muted d-block">Fecha Contrato</small>
                        <span>@Model.FechaContrato.ToString("dd/MM/yyyy")</span>
                    </div>
                }

            </div>
        </div>

        <!-- SECCIÓN: SERVICIOS ESENCIALES -->
        @{
            var listaServicios = await _servicioEsencialService.GetByEventoIdAsync(Model.EventoId);
        }
        <partial name="_GestorServicios" model="listaServicios" />

        <!-- SECCIÓN: FIANZA -->
        @if (Model.FianzaId != null)
        {
            <div class="card shadow-sm border-warning mb-3">
                <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h6 class="mb-0"><i class="fa-solid fa-shield-alt me-2"></i>Fianza</h6>
                    <span class="badge bg-light text-dark">@Model.DetalleFianza.Estado</span>
                </div>
                <div class="card-body">
                    <h5 class="text-center mb-3">@Model.DetalleFianza.Monto.ToString("C0")</h5>
                    @if (!string.IsNullOrEmpty(Model.DetalleFianza.Observaciones))
                    {
                        <div class="mb-3">
                            <small class="text-muted d-block">Observaciones</small>
                            <p class="small mb-0 text-break">@Model.DetalleFianza.Observaciones</p>
                        </div>
                    }
                    <div class="d-grid">
                        <a asp-controller="Fianza"
                           asp-action="Details"
                           asp-route-id="@Model.FianzaId"
                           asp-route-returnUrl="@Url.Action("Details", "Evento", new { id = Model.EventoId })"
                           class="btn btn-outline-dark btn-sm">
                            <i class="fa-solid fa-eye me-2"></i>Gestionar Fianza
                        </a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card shadow-sm border-secondary bg-light mb-3">
                <div class="card-body text-center">
                    <p class="text-muted mb-2"><i class="fa-solid fa-info-circle me-1"></i>Sin fianza registrada</p>
                    <a asp-controller="Fianza" asp-action="Create" asp-route-eventoId="@Model.EventoId" 
                       class="btn btn-warning btn-sm">
                        <i class="fa-solid fa-plus me-1"></i>Registrar
                    </a>
                </div>
            </div>
        }
    </div>
</div>

<!-- MODAL DE REPROGRAMACIÓN -->
<div class="modal fade" id="modalReprogramar" tabindex="-1" aria-labelledby="modalReprogramarLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title fw-bold" id="modalReprogramarLabel">
                    <i class="fa-solid fa-calendar-days me-2"></i>Reprogramar Evento
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-action="Reprogramar" method="post" id="formReprogramar">
                <div class="modal-body">
                    <div class="alert alert-info small border-0 bg-light mb-3">
                        <i class="fa-solid fa-circle-info me-1 text-primary"></i>
                        La fecha original se guardará en observaciones. Si eliges "Fecha por definir", el cupo actual quedará libre.
                    </div>

                    <input type="hidden" name="EventoId" value="@Model.EventoId" />

                    <div class="p-3 border rounded mb-3 d-flex align-items-center">
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input me-2" type="checkbox" id="chkFechaIndefinida" 
                                   name="FechaIndefinida" value="true" style="cursor: pointer;">
                            <label class="form-check-label text-dark" for="chkFechaIndefinida" style="cursor: pointer;">
                                Dejar fecha por definir (Libera el cupo actual)
                            </label>
                        </div>
                    </div>

                    <div id="panelFechas">
                        <div class="mb-3">
                            <label class="form-label text-dark">Nueva Fecha</label>
                            <input type="date" class="form-control" id="NuevaFecha" name="NuevaFecha" />
                        </div>

                        <div class="row">
                            <div class="col-6 mb-3">
                                <label class="form-label text-dark">Hora Inicio</label>
                                <input type="time" class="form-control" id="NuevaHoraInicio" name="NuevaHoraInicio" 
                                       value="@Model.HoraInicio.ToString("hh\\:mm")" />
                            </div>
                            <div class="col-6 mb-3">
                                <label class="form-label text-dark">Hora Fin</label>
                                <input type="time" class="form-control" id="NuevaHoraFin" name="NuevaHoraFin" 
                                       value="@Model.HoraFin.ToString("hh\\:mm")" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-warning text-dark fw-bold">
                        <i class="fa-solid fa-check me-2"></i>Confirmar Cambio
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        var chk = document.getElementById('chkFechaIndefinida');
        var panel = document.getElementById('panelFechas');
        var inputs = panel.querySelectorAll('input');

        if (chk) {
            chk.addEventListener('change', function() {
                if (this.checked) {
                    panel.style.opacity = '0.5';
                    panel.style.pointerEvents = 'none';
                    inputs.forEach(function(input) {
                        input.readOnly = true;
                        input.value = '';
                    });
                } else {
                    panel.style.opacity = '1';
                    panel.style.pointerEvents = 'auto';
                    inputs.forEach(function(input) {
                        input.readOnly = false;
                    });
                }
            });
        }
    });
</script>
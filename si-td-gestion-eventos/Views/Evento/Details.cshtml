@using si_td_gestion_eventos.Models.Enums
@model si_td_gestion_eventos.Models.ViewModels.EventoVM
@using si_td_gestion_eventos.Services.Contracts
@inject IServicioEsencialService _servicioEsencialService

@{
    ViewData["Title"] = $"{Model.Tipo} de {Model.ClienteNombreCompleto}";

    // Cálculos de visualización rápida
    float costoTotal = (float)(Model.CostoAlquiler + (Model.MontoAireAcondicionado ?? 0));
    float saldo = costoTotal - (float)Model.TotalPagado;

    // Color del estado
    string badgeClass = Model.Estado switch
    {
        EventoEstado.PendienteAdeudado => "bg-warning text-dark",
        EventoEstado.PendientePagado => "bg-success",
        EventoEstado.Realizado => "bg-info",
        EventoEstado.Cancelado => "bg-danger",
        EventoEstado.Reprogramado => "bg-primary",
        _ => "bg-secondary"
    };
}

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fa-solid fa-check-circle me-2"></i>@TempData["Ok"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="fa-solid fa-circle-exclamation me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-start mb-4 gap-3">
    <div class="flex-grow-1">
        <h1 class="page-title mb-2">
            <i class="fa-solid fa-champagne-glasses me-2 text-primary"></i>
            @Model.Tipo de @Model.ClienteNombreCompleto
        </h1>
        <p class="text-muted mb-0">
            <i class="fa-solid fa-calendar me-1"></i>
            @Model.Inicio.ToString("dddd, dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-ES"))
        </p>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Reporte" asp-action="DescargarPdfIndividual" asp-route-id="@Model.EventoId"
           class="btn btn-danger btn-sm" title="Descargar Reporte del Evento">
            <i class="fa-solid fa-file-pdf me-1"></i><span class="d-none d-md-inline"> Reporte PDF</span>
        </a>

        @if (Model.Estado != EventoEstado.Realizado && Model.Estado != EventoEstado.Cancelado)
        {
            <button type="button" class="btn btn-warning text-dark btn-sm"
                    data-bs-toggle="modal" data-bs-target="#modalReprogramar"
                    title="Reprogramar Fecha">
                <i class="fa-solid fa-clock-rotate-left me-1"></i><span class="d-none d-md-inline">Reprogramar</span>
            </button>
        }

        <a asp-action="Edit" asp-route-id="@Model.EventoId" class="btn btn-primary btn-sm">
            <i class="fa-solid fa-pen me-1"></i><span class="d-none d-md-inline">Editar</span>
        </a>

        @if (Model.PermiteAgregarPago)
        {
            <a asp-controller="Pago" asp-action="Create" asp-route-eventoId="@Model.EventoId"
               class="btn btn-success btn-sm">
                <i class="fa-solid fa-plus me-1"></i><span class="d-none d-md-inline">Agregar Pago</span>
            </a>
        }

        <a asp-action="Index" class="btn btn-secondary btn-sm">
            <i class="fa-solid fa-arrow-left"></i>
        </a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        @* INFORMACIÓN FINANCIERA *@
        <div class="card shadow-sm mb-3 border-start border-4">
            <div class="card-header bg-transparent">
                <h6 class="mb-0"><i class="fa-solid fa-dollar-sign me-2"></i>Información Financiera y Tecnica</h6>
            </div>
            <div class="card-body">
                <div class="row g-3 mb-4">
                    <div class="col-6 col-md-4 col-lg-2">
                        <small class="text-muted d-block mb-1">Costo del Alquiler</small>
                        <strong class="fs-6">@Model.CostoAlquiler.ToString("C")</strong>
                    </div>
                    <div class="col-6 col-md-4 col-lg-2">
                        <small class="text-muted d-block mb-1">Monto de Reserva</small>
                        <strong class="fs-6">@Model.MontoReserva.ToString("C")</strong>
                    </div>
                    <div class="col-6 col-md-4 col-lg-3">
                        <small class="text-muted d-block mb-1">Aire Acondicionado</small>
                        <strong class="fs-6">@(Model.MontoAireAcondicionado?.ToString("C") ?? "No incluido")</strong>
                    </div>
                    <div class="col-6 col-md-6 col-lg-2  ">
                        <small class="text-muted d-block mb-1">Invitados</small>
                        <strong class="fs-6"><i class="fa-solid fa-users me-1 text-muted"></i>@Model.CantidadPersonas</strong>
                    </div>
                    <div class="col-6 col-md-6 col-lg-3 ">
                        <small class="text-muted d-block mb-1">Estado Actual</small>
                        <span class="badge @badgeClass">@Html.DisplayFor(m => m.Estado)</span>
                    </div>
                </div>
                <hr class="my-3" />
                <div class="row g-3 align-items-center">
                    <div class="col-md-4">
                        <small class="text-muted d-block mb-1">Total Pagado</small>
                        <strong class="fs-5 text-success">@Model.TotalPagado.ToString("C")</strong>
                    </div>
                    <div class="col-md-4">
                        <small class="text-muted d-block mb-1">Saldo Restante</small>
                        <strong class="fs-5 @(saldo > 0.01f ? "text-danger" : "text-success")">
                            @saldo.ToString("C")
                        </strong>
                    </div>
                    <div class="col-md-4 text-md-end">
                        <a asp-controller="Pago" asp-action="Index" asp-route-eventoId="@Model.EventoId"
                           class="btn btn-outline-primary btn-sm">
                            <i class="fa-solid fa-list me-1"></i>Ver Historial
                        </a>
                    </div>
                </div>
            </div>
        </div>

        @* OBSERVACIONES *@
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0"><i class="fa-solid fa-file-lines me-2"></i>Observaciones</h6>
                <a asp-action="Edit" asp-route-id="@Model.EventoId" class="btn btn-sm btn-light">
                    <i class="fa-solid fa-pen me-1"></i>Editar
                </a>
            </div>
            <div class="card-body">
                <p class="mb-0" style="white-space: pre-line;">
                    @(string.IsNullOrEmpty(Model.Observaciones) ? "Sin observaciones registradas." : Model.Observaciones)
                </p>
            </div>
        </div>

        @* CONTACTOS *@
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-secondary text-white">
                <h6 class="mb-0"><i class="fa-solid fa-users me-2"></i>Contactos</h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6 border-end">
                        <h6 class="text-primary mb-2 border-bottom pb-2">Cliente Contratante</h6>
                        <div class="mb-2">
                            <small class="text-muted d-block">Nombre / Razón Social</small>
                            <strong class="d-block text-break">@Model.ClienteNombreCompleto</strong>
                        </div>
                        <div class="mb-2">
                            <small class="text-muted d-block">Teléfono</small>
                            <span class="d-block text-break">@Model.ClienteTelefono</span>
                        </div>
                        <div class="mb-0">
                            <small class="text-muted d-block">Domicilio</small>
                            <span class="d-block text-break">@Model.ClienteDomicilio</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-primary mb-2 border-bottom pb-2">Responsable del Salón</h6>
                        <div class="mb-2">
                            <small class="text-muted d-block">Nombre</small>
                            <strong class="d-block text-break">@Model.ResponsableNombre</strong>
                        </div>
                        <div class="mb-2">
                            <small class="text-muted d-block">Cédula</small>
                            <span>@Model.ResponsableCedula</span>
                        </div>
                        <div class="mb-0">
                            <small class="text-muted d-block">Teléfono</small>
                            <span class="d-block text-break">@Model.ResponsableTelefono</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* SIDEBAR *@
    <div class="col-lg-5">
        @* AGENDA *@
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-warning text-light">
                <h6 class="mb-0"><i class="fa-solid fa-clock me-2"></i>Agenda</h6>
            </div>
            <div class="card-body">
                @if (Model.EsFechaIndefinida)
                {
                    <div class="text-center py-3">
                        <i class="fa-solid fa-calendar-question fa-3x text-warning mb-3"></i>
                        <h6 class="fw-bold">Fecha por Definir</h6>
                        <button type="button" class="btn btn-warning fw-bold w-100 btn-sm"
                                data-bs-toggle="modal" data-bs-target="#modalReprogramar">
                            <i class="fa-solid fa-calendar-check me-2"></i>Definir Fecha
                        </button>
                    </div>
                }
                else
                {
                    <div class="mb-3 pb-2 border-bottom">
                        <small class="text-muted d-block">Fecha del Evento</small>
                        <strong class="fs-6">@Model.Inicio.ToString("dd/MM/yyyy")</strong>
                    </div>
                    <div class="mb-3 pb-2 border-bottom">
                        <small class="text-muted d-block">Horario</small>
                        <strong>@Model.HoraInicio?.ToString(@"hh\:mm") - @Model.HoraFin?.ToString(@"hh\:mm")</strong>
                    </div>
                    <div class="mb-0">
                        <small class="text-muted d-block">Fecha Contrato</small>
                        <span>@Model.FechaContrato.ToString("dd/MM/yyyy")</span>
                    </div>
                }
            </div>
        </div>

        @* SERVICIOS *@
        @{
            var listaServicios = await _servicioEsencialService.GetByEventoIdAsync(Model.EventoId);
        }
        <partial name="_GestorServicios" model="listaServicios" />

        @* FIANZA *@
        @if (Model.FianzaId != null)
        {
            <div class="card shadow-sm border-warning mb-3">
                <div class="card-header bg-warning text-light d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h6 class="mb-0"><i class="fa-solid fa-shield-alt me-2"></i>Fianza</h6>
                    <span class="badge bg-light text-dark">@Model.DetalleFianza.Estado</span>
                </div>
                <div class="card-body">
                    <h5 class="text-center mb-3">@Model.DetalleFianza.Monto.ToString("C0")</h5>
                    @if (!string.IsNullOrEmpty(Model.DetalleFianza.Observaciones))
                    {
                        <div class="mb-3">
                            <small class="text-muted d-block">Observaciones</small>
                            <p class="small mb-0 text-break">@Model.DetalleFianza.Observaciones</p>
                        </div>
                    }
                    <div class="d-grid">
                        <a asp-controller="Fianza" asp-action="Details" asp-route-id="@Model.FianzaId"
                           asp-route-returnUrl="@Url.Action("Details", "Evento", new { id = Model.EventoId })"
                           class="btn btn-outline-light btn-sm text-light border-secondary">
                            <i class="fa-solid fa-eye me-2"></i>
                            <Label class="text-light">Detalles Fianza</Label>
                        </a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card shadow-sm border-secondary bg-light mb-3">
                <div class="card-body text-center">
                    <p class="text-muted mb-2"><i class="fa-solid fa-info-circle me-1"></i>Sin fianza registrada</p>
                    <a asp-controller="Fianza" asp-action="Create" asp-route-eventoId="@Model.EventoId"
                       class="btn btn-warning btn-sm">
                        <i class="fa-solid fa-plus me-1"></i>Registrar
                    </a>
                </div>
            </div>
        }

        @* ZONA DE ADMINISTRACIÓN *@
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-danger text-white py-2">
                <h6 class="mb-0 fw-bold small"><i class="fas fa-user-shield me-2"></i>Administración Manual de Estados</h6>
            </div>
            <div class="card-body bg-transparent">
                <p class="text-muted mb-2" style="font-size: 0.8rem;">Acciones para forzar estados manualmente.</p>
                <button type="button" class="btn btn-sm btn-outline-danger w-100 fw-bold"
                        data-bs-toggle="modal" data-bs-target="#modalCambiarEstadoManual">
                    <i class="fas fa-tools me-2"></i>Manipular Estados
                </button>
            </div>
        </div>
    </div>
</div>

@* MODAL REPROGRAMAR DEFINITIVO *@
<div class="modal fade" id="modalReprogramar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title fw-bold">Reprogramar Evento</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Reprogramar" method="post" id="formReprogramar">
                <div class="modal-body">
                    @* ID del evento oculto *@
                    <input type="hidden" name="EventoId" value="@Model.EventoId" />

                    @* SWITCH DE FECHA INDEFINIDA CON LÓGICA DE BLOQUEO *@
                    <div class="form-check form-switch mb-3">
                        @if (Model.EsFechaIndefinida)
                        {
                            @* CASO A: El evento YA ES indefinido. 
                               Bloqueamos el switch para obligar al usuario a elegir una fecha concreta. *@
                            <input class="form-check-input" type="checkbox" id="chkFechaIndefinida" disabled>
                            <label class="form-check-label text-muted" for="chkFechaIndefinida">
                                Dejar fecha por definir
                                <small class="d-block text-dark mt-1">
                                    <i class="fa-solid fa-info-circle me-1"></i>
                                    El evento ya se encuentra sin fecha. Debes seleccionar una nueva fecha para reprogramar.
                                </small>
                            </label>
                            @* Enviamos explícitamente false para que el Validator exija fechas *@
                            <input type="hidden" name="FechaIndefinida" value="false" />
                        }
                        else
                        {
                            @* CASO B: El evento TIENE fecha.
                               Permitimos pasar a indefinida. *@
                            <input class="form-check-input" type="checkbox" name="FechaIndefinida" id="chkFechaIndefinida" value="true">
                            <label class="form-check-label text-dark" for="chkFechaIndefinida">Dejar fecha por definir</label>
                        }
                    </div>

                    @* PANEL DE FECHAS *@
                    <div id="panelFechas" class="row">
                        <div class="col-6">
                            <label class="small fw-bold text-dark">Nuevo Inicio</label>
                            @* IDs agregados para el JS: NuevaFechaInicio, NuevaHoraInicio *@
                            <input type="date" id="NuevaFechaInicio" name="NuevaFechaInicio" class="form-control mb-2 input-repro" required>
                            <input type="time" id="NuevaHoraInicio" name="NuevaHoraInicio" class="form-control input-repro" value="@Model.HoraInicio?.ToString(@"hh\:mm")" required>
                        </div>
                        <div class="col-6">
                            <label class="small text-dark fw-bold">Nuevo Fin</label>
                            @* IDs agregados para el JS: NuevaFechaFin, NuevaHoraFin *@
                            <input type="date" id="NuevaFechaFin" name="NuevaFechaFin" class="form-control mb-2 input-repro" required>
                            <input type="time" id="NuevaHoraFin" name="NuevaHoraFin" class="form-control input-repro" value="@Model.HoraFin?.ToString(@"hh\:mm")" required>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-warning fw-bold shadow-sm">Confirmar Cambio</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* MODAL ADMIN *@
<div class="modal fade" id="modalCambiarEstadoManual" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-danger shadow-lg">
            <div class="modal-header bg-danger text-white">
                <h5><i class="fas fa-exclamation-triangle me-2"></i>Manipulación Manual</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CambiarEstado" method="post">
                <div class="modal-body">
                    <input type="hidden" name="eventoId" value="@Model.EventoId" />
                    <div class="alert alert-danger p-2 small mb-3">
                        <i class="fas fa-exclamation-triangle me-1"></i>
                        Forzar cambio ignorando reglas de negocio.
                    </div>
                    <label class="fw-bold mb-2 text-dark">Nuevo Estado:</label>
                    <select name="nuevoEstado" class="form-select border-danger fw-bold" required asp-items="Html.GetEnumSelectList<EventoEstado>()">
                        <option value="" disabled selected>-- Elegir Estado --</option>
                    </select>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger btn-sm px-4 fw-bold shadow-sm" onclick="return confirm('¿Está seguro de cambiar el estado manualmente?')">
                        <i class="fas fa-check me-2"></i>Guardar Cambio
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        // --- LÓGICA DE REPROGRAMACIÓN (CORREGIDA) ---
        var chk = document.getElementById('chkFechaIndefinida');
        var panel = document.getElementById('panelFechas');
        // Seleccionamos todos los inputs dentro del panel que tengan la clase 'input-repro'
        // o simplemente seleccionamos todos los inputs del panel
        var inputsFecha = panel.querySelectorAll('input');

        function toggleEstadoFechas() {
            var isIndefinida = chk.checked;

            // 1. Efecto Visual
            panel.style.opacity = isIndefinida ? '0.4' : '1';

            // 2. Bloqueo de Interacción y Atributos
            inputsFecha.forEach(function(input) {
                if (isIndefinida) {
                    // Si es indefinida: Deshabilitamos edición, limpiamos valor y QUITAMOS REQUIRED
                    input.readOnly = true; // Usamos readOnly para que no se borre el valor al enviar si fuera necesario, o disabled si queremos null
                    input.disabled = true; // Disabled hace que no se envíe el valor (llega null al server)
                    input.value = '';      // Limpiamos visualmente
                    input.removeAttribute('required'); // <--- LA CLAVE DEL ARREGLO
                } else {
                    // Si es fecha específica: Habilitamos y PONEMOS REQUIRED
                    input.readOnly = false;
                    input.disabled = false;
                    input.setAttribute('required', 'required');
                }
            });
        }

        if (chk && panel) {
            // Escuchar cambios
            chk.addEventListener('change', toggleEstadoFechas);

            // Ejecutar al cargar la página por si viene marcado del servidor (ej: error de validación previo)
            toggleEstadoFechas();
        }

        // --- LÓGICA DE COPIADO DE FECHAS (UX) ---
        var inputInicio = document.getElementById('NuevaFechaInicio');
        var inputFin = document.getElementById('NuevaFechaFin');
        if(inputInicio && inputFin){
            inputInicio.addEventListener('change', function() {
                // Solo copiar si la fecha fin está vacía
                if (!inputFin.value) inputFin.value = this.value;
            });
        }
    });
</script>

@using si_td_gestion_eventos.Models.Enums
@model si_td_gestion_eventos.Models.ViewModels.EventoVM
@using si_td_gestion_eventos.Services.Contracts
@inject IServicioEsencialService _servicioEsencialService

@{
    ViewData["Title"] = $"Detalles del Evento: {Model.Tipo}";
}

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Ok"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}


<div class="card">
    <div class="card-header">
        <h2 class="card-title">@ViewData["Title"]</h2>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <h4>Información General</h4>
                <hr />
                <dl class="row">
                    <dt class="col-sm-5">Cliente</dt>
                    <dd class="col-sm-7">@Model.ClienteNombreCompleto</dd>

                    <dt class="col-sm-5">Tipo de Cliente</dt>
                    <dd class="col-sm-7">
                        @(Model.TipoCli == TipoCliente.PersonaFisica ? "Persona Fisica" : "Persona Juridica")
                    </dd>
                
                    <dt class="col-sm-5">Tipo de Evento</dt>
                    <dd class="col-sm-7">@Model.Tipo</dd>

                    <dt class="col-sm-5">Estado</dt>
                    <dd class="col-sm-7">@Model.Estado</dd>

                    <dt class="col-sm-5">Cantidad de Personas</dt>
                    <dd class="col-sm-7">@Model.CantidadPersonas</dd>

                    <dt class="col-sm-5">Observaciones</dt>
                    <dd class="col-sm-7">@Model.Observaciones</dd>

                </dl>

                <h4>Fechas y Horarios</h4>
                <hr />
                <dl class="row">
                    <dt class="col-sm-5">Fecha del Contrato</dt>
                    <dd class="col-sm-7">@Model.FechaContrato.ToLongDateString()</dd>

                    <dt class="col-sm-5">Fecha de Inicio</dt>
                    <dd class="col-sm-7">@Model.Inicio.ToLongDateString()</dd>

                    <dt class="col-sm-5">Fecha de Fin</dt>
                    <dd class="col-sm-7">@Model.Fin.ToLongDateString()</dd>

                    <dt class="col-sm-5">Horario</dt>
                    <dd class="col-sm-7">De @Model.HoraInicio.ToString("hh\\:mm") a @Model.HoraFin.ToString("hh\\:mm")</dd>
                </dl>
            </div>

            <div class="col-md-6">
                <h4>Información Financiera</h4>
                <hr />
                <div class="col-md-6">
                <dl class="row">
                    <dt class="col-sm-5">Costo del Alquiler</dt>
                    <dd class="col-sm-7">@Model.CostoAlquiler.ToString("C")</dd>

                    <dt class="col-sm-5">Monto de Reserva</dt>
                    <dd class="col-sm-7">@Model.MontoReserva.ToString("C")</dd>

                    <dt class="col-sm-5">Costo Aire Acond.</dt>
                    <dd class="col-sm-7">@(Model.MontoAireAcondicionado?.ToString("C") ?? "No incluido")</dd>

                    <dt class="col-sm-5 text-success">Total Pagado</dt>
                    <dd class="col-sm-7 fw-bold text-success">@Model.TotalPagado.ToString("C")</dd>

                    <dt class="col-sm-5 text-danger">Saldo Restante</dt>
                    <dd class="col-sm-7 fw-bold text-danger">@Model.SaldoRestante.ToString("C")</dd>
                </dl>
            </div>

            <h4>Informacion del Responsable</h4>
            <hr />
            <dl class="row">
                <dt class="col-sm-5">Responsable</dt>
                <dd class="col-sm-7">@Model.ResponsableNombre</dd>

                <dt class="col-sm-5">Telefono del Responsable</dt>
                <dd class="col-sm-7">@Model.ResponsableTelefono</dd>

                <dt class="col-sm-5">CI del Responsable</dt>
                <dd class="col-sm-7">@Model.ResponsableCedula</dd>
            </dl>

                @if (Model.FianzaId != null)
                {
                    <h4>Fianza</h4>
                    <hr />
                    <dl class="row">
                        <dt class="col-sm-5">Fecha</dt>
                        <dd class="col-sm-7">@Model.DetalleFianza.FechaRegistro.ToShortDateString()</dd>

                        <dt class="col-sm-5">Estado  Fianza</dt>
                        <dd class="col-sm-7">@Model.DetalleFianza.Estado</dd>

                        <dt class="col-sm-5">Monto Fianza</dt>
                        <dd class="col-sm-7">@Model.DetalleFianza.Monto.ToString("C2")</dd>

                        @if (!string.IsNullOrEmpty(Model.DetalleFianza.Observaciones))
                        {
                            <dt class="col-sm-5">Observaciones</dt>
                            <dd class="col-sm-7">@Model.DetalleFianza.Observaciones</dd>
                        }
                    </dl>
}

        </div>
    </div>
  </div>
    
    <div class="card-footer text-muted d-flex justify-content-between align-items-center">
        <div>
            <a asp-action="Edit" asp-route-id="@Model.EventoId" class="btn btn-primary">
                <i class="fa-solid fa-pen me-2"></i>Editar Evento
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fa-solid fa-arrow-left me-2"></i>Volver
            </a>
        </div>

        <div>
            @if (Model.FianzaId == null)
            {
                <a asp-controller="Fianza"
                   asp-action="Create"
                   asp-route-eventoId="@Model.EventoId"
                   class="btn btn-success">
                    <i class="fas fa-plus-circle me-2"></i>Registrar Fianza
                </a>
            }
            else
            {
                <a asp-controller="Fianza"
                   asp-action="Details"
                   asp-route-id="@Model.FianzaId"
                   class="btn btn-info text-white">
                    <i class="fas fa-hand-holding-usd me-2"></i> Ver Fianza
                </a>
            }
        </div>
    </div>
    <div class="row mt-4">
        <div class="col-12">
            @{
                // Obtenemos la lista de servicios para este evento (ID del modelo actual)
                var listaServicios = await _servicioEsencialService.GetByEventoIdAsync(Model.EventoId);
            }

            <partial name="_GestorServicios" model="listaServicios" />
        </div>
    </div>
</div>

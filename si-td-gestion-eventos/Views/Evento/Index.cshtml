@using si_td_gestion_eventos.Models.Enums
@model si_td_gestion_eventos.Infrastructure.PaginatedList<si_td_gestion_eventos.Models.ViewModels.EventoVM>

@{
    ViewData["Title"] = "Gestión de Eventos";

    string q = ViewBag.Search as string ?? "";
    int pageSize = (int)(ViewBag.PageSizeList?.SelectedValue ?? 10);
    DateTime? fechaDesde = ViewBag.FechaDesde as DateTime?;
    DateTime? fechaHasta = ViewBag.FechaHasta as DateTime?;
    EventoEstado? estado = ViewBag.Estado as EventoEstado?;
    string ordenPor = ViewBag.OrdenPorList?.SelectedValue?.ToString() ?? "fecha_inicio_asc";

    // Diccionario para persistir filtros en los links de paginación
    var routeData = new Dictionary<string, string> {
        { "q", q },
        { "fechaDesde", fechaDesde?.ToString("yyyy-MM-dd") },
        { "fechaHasta", fechaHasta?.ToString("yyyy-MM-dd") },
        { "estado", estado?.ToString() },
        { "ordenPor", ordenPor },
        { "pageSize", pageSize.ToString() }
    };
}

@* ALERTAS DE SISTEMA ORIGINALES *@
@if (TempData["Ok"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-check-circle me-2"></i>@TempData["Ok"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-circle-exclamation me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="m-0">Lista de Eventos</h2>
    <a class="btn btn-primary" asp-action="Create">
        <i class="fa-solid fa-plus me-1"></i> Nuevo Evento
    </a>
</div>

@* FORMULARIO DE FILTROS EN DOS LÍNEAS *@
<form method="get" class="mb-4">
    <div class="row g-3 mb-3 align-items-end">
        <div class="col-md-6">
            <label for="q" class="form-label fw-bold">Búsqueda</label>
            <input type="text" name="q" id="q" class="form-control" value="@q"
                   placeholder="Nombre, CI, RUT o Empresa..." />
        </div>
        <div class="col-md-3">
            <label for="fechaDesde" class="form-label">Fecha Desde</label>
            <input type="date" name="fechaDesde" id="fechaDesde" class="form-control" value="@fechaDesde?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-3">
            <label for="fechaHasta" class="form-label">Fecha Hasta</label>
            <input type="date" name="fechaHasta" id="fechaHasta" class="form-control" value="@fechaHasta?.ToString("yyyy-MM-dd")" />
        </div>
    </div>

    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label for="estado" class="form-label">Estado</label>
            <select name="estado" id="estado" class="form-select" asp-items="ViewBag.EstadosList">
                <option value="">-- Mostrar Todos --</option>
            </select>
        </div>
        <div class="col-md-3">
            <label for="ordenPor" class="form-label">Ordenar por</label>
            <select name="ordenPor" id="ordenPor" class="form-select" asp-items="ViewBag.OrdenPorList" onchange="this.form.submit()">
            </select>
        </div>
        <div class="col-md-2">
            <label for="pageSize" class="form-label">Mostrar por pagina</label>
            <select name="pageSize" id="pageSize" class="form-select" asp-items="ViewBag.PageSizeList" onchange="this.form.submit()">
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary w-100" title="Buscar">
                <i class="fa-solid fa-magnifying-glass me-2"></i>Buscar
            </button>
        </div>
    </div>
</form>

@* TABLA ORIGINAL *@
<div class="table-responsive shadow-sm rounded">
    <table class="table table-striped table-hover mb-0">
        <thead class="table-dark">
            <tr>
                <th>Cliente Responsable</th>
                <th>Tipo de Evento</th>
                <th>Fecha Inicio</th>
                <th>Estado</th>
                <th>Observaciones</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center py-4">
                        <i class="fa-solid fa-calendar-xmark fa-2x text-muted mb-2 d-block"></i>
                        <span class="text-muted">No se encontraron eventos con los filtros aplicados.</span>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var e in Model)
                {
                    string estadoClass = e.Estado switch
                    {
                        EventoEstado.PendientePagado => "bg-success",
                        EventoEstado.PendienteAdeudado => "bg-warning text-dark",
                        EventoEstado.Realizado => "bg-secondary",
                        EventoEstado.Cancelado => "bg-danger",
                        EventoEstado.Reprogramado => "bg-info text-dark",
                        _ => "bg-secondary"
                    };

                    <tr>
                        <td class="fw-bold">@e.ClienteNombreCompleto</td>
                        <td>@e.Tipo</td>
                        <td>
                            @if (e.Inicio.Year == 1900)
                            {
                                <span class="badge bg-warning text-dark border border-dark">
                                    <i class="fa-solid fa-calendar-circle-question me-1"></i>Por Definir
                                </span>
                            }
                            else
                            {
                                @e.Inicio.ToString("dd/MM/yyyy")
                            }
                        </td>
                        <td>
                            <span class="badge @estadoClass">@Html.DisplayFor(_ => e.Estado)</span>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(e.Observaciones))
                            {
                                <span title="@e.Observaciones" class="d-inline-block text-truncate" style="max-width: 150px;">
                                    @e.Observaciones
                                </span>
                            }
                            else
                            {
                                <span class="text-muted fst-italic">Sin obs.</span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="btn-group">
                                <a asp-action="Details" asp-route-id="@e.EventoId" class="btn btn-sm btn-outline-info" title="Detalles">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                                
                                @if (e.Estado != EventoEstado.Realizado && e.Estado != EventoEstado.Cancelado)
                                {
                                    <a asp-action="Edit" asp-route-id="@e.EventoId" class="btn btn-sm btn-outline-secondary" title="Editar">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                }

                                @if (e.Estado != EventoEstado.Cancelado && e.Estado != EventoEstado.Realizado)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-warning"
                                            title="Reprogramar / Asignar Fecha"
                                            data-bs-toggle="modal" data-bs-target="#modalReprogramarIndex"
                                            onclick="setEventoId(@e.EventoId)">
                                        <i class="fa-solid fa-clock-rotate-left"></i>
                                    </button>
                                }

                                @if (e.Estado != EventoEstado.Realizado && e.Estado != EventoEstado.Cancelado)
                                {
                                    <a asp-action="Cancel" asp-route-id="@e.EventoId" class="btn btn-sm btn-outline-danger" title="Cancelar">
                                        <i class="fa-solid fa-ban"></i>
                                    </a>
                                }

                                @if (e.SaldoRestante > 0 && e.Estado != EventoEstado.Cancelado && e.Estado != EventoEstado.Realizado)
                                {
                                    <a asp-controller="Pago" asp-action="Create" asp-route-eventoId="@e.EventoId"
                                       class="btn btn-sm btn-outline-success" title="Agregar Pago">
                                        <i class="fa-solid fa-dollar-sign"></i>
                                    </a>
                                }
                                else
                                {
                                    <a asp-controller="Pago" asp-action="Index" asp-route-eventoId="@e.EventoId"
                                       class="btn btn-sm btn-outline-primary" title="Historial">
                                        <i class="fa-solid fa-list"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@* PAGINACIÓN CON PERSISTENCIA *@
<div class="d-flex justify-content-between align-items-center mt-3">
    <nav aria-label="Paginación">
        <ul class="pagination mb-0">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link bg-transparent" asp-action="Index" asp-all-route-data="routeData"
                   asp-route-page="@(Model.PageIndex - 1)">Anterior</a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-all-route-data="routeData" asp-route-page="@i">@i</a>
                </li>
            }
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link bg-transparent" asp-action="Index" asp-all-route-data="routeData"
                   asp-route-page="@(Model.PageIndex + 1)">Siguiente</a>
            </li>
        </ul>
    </nav>
    <p class="text-muted small">
        Página @Model.PageIndex de @Model.TotalPages (Total: @Model.TotalCount)
    </p>
</div>

@* MODAL REPROGRAMAR *@
<div class="modal fade" id="modalReprogramarIndex" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-warning">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title fw-bold">
                    <i class="fa-solid fa-calendar-days me-2"></i>Reprogramar Evento
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-action="Reprogramar" method="post" id="formReprogramarIndex">
                <div class="modal-body">
                    <input type="hidden" id="Index_EventoId" name="EventoId" value="" />

                    <div class="alert alert-info small border-0 bg-light mb-3">
                        <i class="fa-solid fa-circle-info me-1 text-primary"></i>
                        Seleccione el nuevo rango de fecha y hora.
                    </div>

                    <div class="p-3 border rounded mb-3 bg-light">
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" id="chkIndexIndefinida"
                                   name="FechaIndefinida" value="true" style="cursor: pointer;">
                            <label class="form-check-label text-dark fw-bold" for="chkIndexIndefinida" style="cursor: pointer;">
                                Dejar fecha por definir
                            </label>
                        </div>
                    </div>

                    <div id="panelFechasIndex">
                        <div class="row">
                            <div class="col-6 mb-3">
                                <label class="form-label text-dark fw-bold border-bottom w-100">Nuevo Inicio</label>
                                <div class="mb-2">
                                    <label class="small text-muted">Fecha</label>
                                    <input type="date" class="form-control" id="NuevaFechaInicio" name="NuevaFechaInicio" required />
                                </div>
                                <div>
                                    <label class="small text-muted">Hora</label>
                                    <input type="time" class="form-control" name="NuevaHoraInicio" required />
                                </div>
                            </div>

                            <div class="col-6 mb-3">
                                <label class="form-label text-dark fw-bold border-bottom w-100">Nuevo Fin</label>
                                <div class="mb-2">
                                    <label class="small text-muted">Fecha</label>
                                    <input type="date" class="form-control" id="NuevaFechaFin" name="NuevaFechaFin" required />
                                </div>
                                <div>
                                    <label class="small text-muted">Hora</label>
                                    <input type="time" class="form-control" name="NuevaHoraFin" required />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-warning text-dark fw-bold">
                        <i class="fa-solid fa-check me-2"></i>Confirmar Cambio
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function setEventoId(id) {
            document.getElementById('Index_EventoId').value = id;
        }

        document.addEventListener("DOMContentLoaded", function() {
            const chk = document.getElementById('chkIndexIndefinida');
            const panel = document.getElementById('panelFechasIndex');
            const inputs = panel.querySelectorAll('input[type="date"], input[type="time"]');

            if (chk) {
                chk.addEventListener('change', function() {
                    const isIndefinida = this.checked;
                    panel.style.opacity = isIndefinida ? '0.4' : '1';
                    inputs.forEach(input => {
                        if (isIndefinida) {
                            input.readOnly = true;
                            input.style.pointerEvents = 'none';
                            input.value = '';
                            input.removeAttribute('required');
                        } else {
                            input.readOnly = false;
                            input.style.pointerEvents = 'auto';
                            input.setAttribute('required', 'required');
                        }
                    });
                });
            }

            const inputInicio = document.getElementById('NuevaFechaInicio');
            const inputFin = document.getElementById('NuevaFechaFin');

            if(inputInicio && inputFin){
                inputInicio.addEventListener('change', function() {
                    if (!inputFin.value) {
                        inputFin.value = this.value;
                    }
                });
            }
        });
    </script>
}
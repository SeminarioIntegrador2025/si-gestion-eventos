@* Se cambia el modelo para usar el ViewModel, mejorando rendimiento y seguridad *@
@model si_td_gestion_eventos.Infrastructure.PaginatedList<si_td_gestion_eventos.Models.ViewModels.EventoVM>

@{
    ViewData["Title"] = "Gestión de Eventos";
    // Hacemos el casting al tipo correcto (lista de ViewModels)
    var ultimos = ViewBag.Ultimos as List<si_td_gestion_eventos.Models.ViewModels.EventoVM>;
    string q = ViewBag.Search as string ?? "";
    int pageSize = ViewBag.PageSize ?? 10;
}

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Ok"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="m-0">Lista de Eventos</h2>
    <a class="btn btn-primary" asp-action="Create"><i class="fa-solid fa-plus"></i> Nuevo Evento</a>
</div>

<div class="row">
    <div class="col-md-8">
        <form method="get" class="row g-2 mb-3">
            <div class="col-sm-8">
                @* Se actualiza el placeholder para reflejar el nuevo modelo de datos *@
                <input name="q" value="@q" class="form-control" placeholder="Buscar por cliente o tipo de evento..." />
            </div>
            <div class="col-sm-2">
                <select name="pageSize" class="form-select" onchange="this.form.submit()">
                    @{
                        int[] sizes = new[] { 5, 10, 20, 50 };
                        foreach (var s in sizes)
                        {
                            <option value="@s" selected="@(s == pageSize)">@s por página</option>
                        }
                    }
                </select>
            </div>
            <div class="col-sm-2">
                <button type="submit" class="btn btn-outline-secondary w-100"><i class="fa-solid fa-magnifying-glass"></i> Buscar</button>
            </div>
        </form>

        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Cliente Responsable</th>
                    <th>Tipo de Evento</th>
                    <th>Fecha Inicio</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        @* Se usa la propiedad pre-formateada del ViewModel *@
                        <td>@e.ClienteNombreCompleto</td>
                        <td>@e.Tipo</td>
                        <td>@e.Inicio.ToShortDateString()</td>
                        <td>
                            @* Opcional: Usar un badge para que el estado se vea mejor *@
                            <span class="badge bg-info text-dark">@e.Estado</span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@e.EventoId" class="btn btn-sm btn-outline-info" title="Ver Detalles"><i class="fa-solid fa-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@e.EventoId" class="btn btn-sm btn-outline-secondary" title="Editar"><i class="fa-solid fa-pen"></i></a>
                            <a asp-action="Cancel" asp-route-id="@e.EventoId" class="btn btn-sm btn-outline-danger" title="Cancelar Evento"><i class="fa-solid fa-ban"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @* El código de paginación no necesita cambios, ya que funciona con la clase PaginatedList *@
        <nav aria-label="Paginación">
            <ul class="pagination">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-q="@q" asp-route-page="@(Model.PageIndex - 1)" asp-route-pageSize="@pageSize">Anterior</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-q="@q" asp-route-page="@i" asp-route-pageSize="@pageSize">@i</a>
                    </li>
                }
                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-q="@q" asp-route-page="@(Model.PageIndex + 1)" asp-route-pageSize="@pageSize">Siguiente</a>
                </li>
            </ul>
        </nav>

        <p class="text-muted">
            Mostrando @Model.Count de @Model.TotalCount eventos (página @Model.PageIndex de @Model.TotalPages).
        </p>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">Últimos eventos agregados</div>
            <ul class="list-group list-group-flush">
                @if (ultimos != null && ultimos.Any())
                {
                    @foreach (var u in ultimos)
                    {
                        <li class="list-group-item">
                            @* Se actualiza para usar las propiedades del ViewModel *@
                            <strong>@u.Tipo - @u.ClienteNombreCompleto</strong><br />
                            <small>Fecha: @u.Inicio.ToShortDateString()</small>
                        </li>
                    }
                }
                else
                {
                    <li class="list-group-item">No hay eventos recientes.</li>
                }
            </ul>
        </div>
    </div>
</div>
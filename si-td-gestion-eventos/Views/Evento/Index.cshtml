@using si_td_gestion_eventos.Models.Enums
@model si_td_gestion_eventos.Infrastructure.PaginatedList<si_td_gestion_eventos.Models.ViewModels.EventoVM>

@{
    ViewData["Title"] = "Gestión de Eventos";

    // Filtros actuales para mantener el estado en la paginación
    string q = ViewBag.Search as string ?? "";
    int pageSize = (int)(ViewBag.PageSizeList.SelectedValue ?? 10);
    DateTime? fechaDesde = ViewBag.FechaDesde as DateTime?;
    DateTime? fechaHasta = ViewBag.FechaHasta as DateTime?;
    EventoEstado? estado = ViewBag.Estado as EventoEstado?;
}

@* ALERTAS DE SISTEMA *@
@if (TempData["Ok"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fa-solid fa-check-circle me-2"></i>@TempData["Ok"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="fa-solid fa-circle-exclamation me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="m-0 page-title"><i class="fa-solid fa-calendar-check me-2 text-primary"></i>Lista de Eventos</h2>
    <a class="btn btn-primary shadow-sm" asp-action="Create">
        <i class="fa-solid fa-plus me-1"></i> Nuevo Evento
    </a>
</div>

@* SECCIÓN DE FILTROS *@
<div class="card shadow-sm mb-4 border-0 bg-light">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label for="q" class="form-label fw-bold small text-muted">Búsqueda Inteligente</label>
                <input type="text" name="q" id="q" class="form-control" value="@q"
                       placeholder="Nombre, CI, RUT o Empresa..." />
            </div>
            <div class="col-md-2">
                <label for="fechaDesde" class="form-label small text-muted">Desde</label>
                <input type="date" name="fechaDesde" id="fechaDesde" class="form-control" value="@fechaDesde?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-2">
                <label for="fechaHasta" class="form-label small text-muted">Hasta</label>
                <input type="date" name="fechaHasta" id="fechaHasta" class="form-control" value="@fechaHasta?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-2">
                <label for="estado" class="form-label small text-muted">Estado</label>
                <select name="estado" id="estado" class="form-select"
                        asp-items="Html.GetEnumSelectList<si_td_gestion_eventos.Models.Enums.EventoEstado>()">
                    <option value="">-- Todos --</option>
                </select>
            </div>
            <div class="col-md-2">
                <label for="ordenPor" class="form-label small text-muted">Orden</label>
                <select name="ordenPor" id="ordenPor" class="form-select" asp-items="ViewBag.OrdenPorList" onchange="this.form.submit()">
                </select>
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary w-100" title="Aplicar Filtros">
                    <i class="fa-solid fa-filter"></i>
                </button>
            </div>
        </form>
    </div>
</div>

@* TABLA DE EVENTOS *@
<div class="table-responsive shadow-sm rounded bg-white">
    <table class="table table-hover mb-0 align-middle">
        <thead class="table-dark">
            <tr>
                <th>Cliente Responsable</th>
                <th>Tipo</th>
                <th>Fecha Inicio</th>
                <th>Estado</th>
                <th>Observaciones</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center py-5">
                        <div class="text-muted opacity-50">
                            <i class="fa-solid fa-calendar-xmark fa-3x mb-3"></i>
                            <h5>No se encontraron eventos</h5>
                            <p class="small">Intenta ajustar los filtros de búsqueda.</p>
                        </div>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var e in Model)
                {
                    string estadoClass = e.Estado switch
                    {
                        EventoEstado.PendientePagado => "bg-success",
                        EventoEstado.PendienteAdeudado => "bg-warning text-dark",
                        EventoEstado.Realizado => "bg-secondary",
                        EventoEstado.Cancelado => "bg-danger",
                        EventoEstado.Reprogramado => "bg-info text-dark",
                        _ => "bg-secondary"
                    };

                    <tr>
                        <td class="fw-semibold">
                            <div class="d-flex align-items-center">
                                <div class="avatar-initials bg-light text-primary rounded-circle me-2 d-flex justify-content-center align-items-center" style="width:35px; height:35px; font-size:0.8rem; font-weight:bold;">
                                    @(e.ClienteNombreCompleto.Length > 0 ? e.ClienteNombreCompleto.Substring(0, 1) : "?")
                                </div>
                                @e.ClienteNombreCompleto
                            </div>
                        </td>
                        <td><span class="badge bg-light text-dark border">@e.Tipo</span></td>

                        @* --- AQUÍ ESTÁ EL CAMBIO VISUAL (Patrón de Presentación) --- *@
                        <td>
                            @if (e.Inicio.Year == 1900)
                            {
                                @* CASO INDEFINIDO: Badge Amarillo *@
                                <span class="badge bg-warning text-dark border border-warning rounded-pill">
                                    <i class="fa-solid fa-calendar-circle-question me-1"></i>Por Definir
                                </span>
                            }
                            else
                            {
                                @* CASO FECHA REAL: Fecha + Hora *@
                                <div class="d-flex flex-column">
                                    <span class="fw-bold text-dark">
                                        @e.Inicio.ToString("dd/MM/yyyy")
                                    </span>
                                    <small class="text-muted" style="font-size: 0.75rem;">
                                        <i class="fa-regular fa-clock me-1"></i>@e.Inicio.ToString("HH:mm")
                                    </small>
                                </div>
                            }
                        </td>
                        @* -------------------------------------------------------- *@

                        <td>
                            <span class="badge @estadoClass rounded-pill">@Html.DisplayFor(_ => e.Estado)</span>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(e.Observaciones))
                            {
                                <span title="@e.Observaciones" class="d-inline-block text-truncate text-muted small" style="max-width: 150px; cursor: help;">
                                    <i class="fa-regular fa-comment-dots me-1"></i>@e.Observaciones
                                </span>
                            }
                            else
                            {
                                <span class="text-muted small opacity-50">-</span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="btn-group shadow-sm" role="group">
                                <a asp-action="Details" asp-route-id="@e.EventoId" class="btn btn-sm btn-outline-primary" title="Ver Detalles">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@e.EventoId" class="btn btn-sm btn-outline-secondary" title="Editar">
                                    <i class="fa-solid fa-pen"></i>
                                </a>

                                @* BOTÓN REPROGRAMAR *@
                                @if (e.Estado == EventoEstado.Cancelado || e.Estado == EventoEstado.Reprogramado)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-warning text-dark"
                                            title="Reprogramar / Asignar Fecha"
                                            data-bs-toggle="modal" data-bs-target="#modalReprogramarIndex"
                                            onclick="setEventoId(@e.EventoId)">
                                        <i class="fa-solid fa-clock-rotate-left"></i>
                                    </button>
                                }
                                else
                                {
                                    <a asp-action="Cancel" asp-route-id="@e.EventoId" class="btn btn-sm btn-outline-danger" title="Cancelar Evento">
                                        <i class="fa-solid fa-ban"></i>
                                    </a>
                                }

                                @* BOTÓN DE PAGOS *@
                                @if (e.SaldoRestante > 0 && e.Estado != EventoEstado.Cancelado)
                                {
                                    <a asp-controller="Pago" asp-action="Create" asp-route-eventoId="@e.EventoId"
                                       class="btn btn-sm btn-outline-success" title="Registrar Pago">
                                        <i class="fa-solid fa-dollar-sign"></i>
                                    </a>
                                }
                                else
                                {
                                    <a asp-controller="Pago" asp-action="Index" asp-route-eventoId="@e.EventoId"
                                       class="btn btn-sm btn-outline-info" title="Historial de Pagos">
                                        <i class="fa-solid fa-receipt"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@* PAGINACIÓN *@
<div class="d-flex justify-content-between align-items-center mt-4">
    <p class="text-muted small mb-0">
        Mostrando página <strong>@Model.PageIndex</strong> de <strong>@Model.TotalPages</strong> (Total: @Model.TotalCount eventos)
    </p>
    <nav aria-label="Navegación de páginas">
        <ul class="pagination pagination-sm mb-0 shadow-sm">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" asp-action="Index"
                   asp-route-page="@(Model.PageIndex - 1)" asp-route-q="@q" asp-route-pageSize="@pageSize">
                    <i class="fa-solid fa-chevron-left"></i>
                </a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-q="@q">@i</a>
                </li>
            }
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link" asp-action="Index"
                   asp-route-page="@(Model.PageIndex + 1)" asp-route-q="@q" asp-route-pageSize="@pageSize">
                    <i class="fa-solid fa-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
</div>

@* MODAL REPROGRAMAR COMPARTIDO *@
<div class="modal fade" id="modalReprogramarIndex" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title fw-bold">
                    <i class="fa-solid fa-calendar-days me-2"></i>Reprogramar Evento
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-action="Reprogramar" method="post" id="formReprogramarIndex">
                <div class="modal-body p-4">
                    <input type="hidden" id="Index_EventoId" name="EventoId" value="" />

                    <div class="alert alert-info small border-0 bg-light mb-4">
                        <i class="fa-solid fa-circle-info me-1 text-primary"></i>
                        Seleccione el nuevo rango de fecha y hora. La disponibilidad será validada automáticamente.
                    </div>

                    @* SWITCH FECHA INDEFINIDA *@
                    <div class="p-3 border rounded mb-4 bg-light">
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" id="chkIndexIndefinida"
                                   name="FechaIndefinida" value="true" style="cursor: pointer;">
                            <label class="form-check-label text-dark fw-bold" for="chkIndexIndefinida" style="cursor: pointer;">
                                Dejar fecha por definir (Libera el cupo)
                            </label>
                        </div>
                    </div>

                    <div id="panelFechasIndex">
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label text-dark fw-bold small">NUEVO INICIO</label>
                                <input type="date" class="form-control mb-2" id="NuevaFechaInicio" name="NuevaFechaInicio" required />
                                <input type="time" class="form-control" name="NuevaHoraInicio" required />
                            </div>
                            <div class="col-6">
                                <label class="form-label text-dark fw-bold small">NUEVO FIN</label>
                                <input type="date" class="form-control mb-2" id="NuevaFechaFin" name="NuevaFechaFin" required />
                                <input type="time" class="form-control" name="NuevaHoraFin" required />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light border-top-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-warning text-dark fw-bold px-4 shadow-sm">
                        <i class="fa-solid fa-check me-2"></i>Confirmar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Transfiere el ID del evento de la fila al campo oculto del modal
        function setEventoId(id) {
            document.getElementById('Index_EventoId').value = id;
        }

        document.addEventListener("DOMContentLoaded", function() {
            const chk = document.getElementById('chkIndexIndefinida');
            const panel = document.getElementById('panelFechasIndex');
            // Selector específico para evitar tocar inputs ocultos (como el Token AntiForgery)
            const inputs = panel.querySelectorAll('input[type="date"], input[type="time"]');

            // --- LÓGICA DE VISIBILIDAD Y VALIDACIÓN ---
            if (chk) {
                chk.addEventListener('change', function() {
                    const isIndefinida = this.checked;

                    // 1. Efecto Visual
                    panel.style.opacity = isIndefinida ? '0.4' : '1';

                    // 2. Manipulación de Atributos para pasar validación HTML5
                    inputs.forEach(input => {
                        if (isIndefinida) {
                            // Si es indefinida: Desactivamos y quitamos REQUIRED
                            input.readOnly = true;
                            input.style.pointerEvents = 'none';
                            input.value = '';
                            input.removeAttribute('required'); // <--- CRÍTICO
                        } else {
                            // Si es normal: Activamos y ponemos REQUIRED
                            input.readOnly = false;
                            input.style.pointerEvents = 'auto';
                            input.setAttribute('required', 'required');
                        }
                    });
                });
            }

            // --- UX: Copiado automático de fechas ---
            const inputInicio = document.getElementById('NuevaFechaInicio');
            const inputFin = document.getElementById('NuevaFechaFin');

            if(inputInicio && inputFin){
                inputInicio.addEventListener('change', function() {
                    // Si el usuario pone fecha inicio y fecha fin está vacía, la copiamos
                    if (!inputFin.value) {
                        inputFin.value = this.value;
                    }
                });
            }
        });
    </script>
}
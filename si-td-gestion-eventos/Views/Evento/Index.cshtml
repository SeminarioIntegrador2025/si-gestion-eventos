@using si_td_gestion_eventos.Models.Enums
@model si_td_gestion_eventos.Infrastructure.PaginatedList<si_td_gestion_eventos.Models.ViewModels.EventoVM>

@{
    ViewData["Title"] = "Gestión de Eventos";

    // Obtenemos los filtros actuales para la paginación
    string q = ViewBag.Search as string ?? "";
    int pageSize = (int)(ViewBag.PageSizeList.SelectedValue ?? 10);
    DateTime? fechaDesde = ViewBag.FechaDesde as DateTime?;
    DateTime? fechaHasta = ViewBag.FechaHasta as DateTime?;
    EventoEstado? estado = ViewBag.Estado as EventoEstado?;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="m-0">Lista de Eventos</h2>
    <a class="btn btn-primary" asp-action="Create"><i class="fa-solid fa-plus"></i> Nuevo Evento</a>
</div>

<form method="get" class="row g-3 mb-3 align-items-end">

    <div class="col-md-3">
        <label for="q" class="form-label">Buscar por Cliente</label>
        <input type="text" name="q" id="q" class="form-control" value="@q" placeholder="Nombre cliente o CI" />
    </div>

    <div class="col-md-2">
        <label for="fechaDesde" class="form-label">Fecha Desde</label>
        <input type="date" name="fechaDesde" id="fechaDesde" class="form-control" value="@fechaDesde?.ToString("yyyy-MM-dd")" />
    </div>

    <div class="col-md-2">
        <label for="fechaHasta" class="form-label">Fecha Hasta</label>
        <input type="date" name="fechaHasta" id="fechaHasta" class="form-control" value="@fechaHasta?.ToString("yyyy-MM-dd")" />
    </div>

    <div class="col-md-3">
        <label for="estado" class="form-label">Estado</label>
        <select name="estado" id="estado" class="form-select" asp-items="ViewBag.EstadosList">
            <option value="">-- Mostrar Todos --</option>
        </select>
    </div>

    <div class="col-md-3">
        <label for="pageSize" class="form-label">Por Página</label>
        <select name="pageSize" id="pageSize" class="form-select" asp-items="ViewBag.PageSizeList" onchange="this.form.submit()">
        </select>
    </div>

    <div class="col-md-4">
        <label for="ordenPor" class="form-label">Ordenar por</label>
        <select name="ordenPor" id="ordenPor" class="form-select" asp-items="ViewBag.OrdenPorList" onchange="this.form.submit()">
        </select>
    </div>

    <div class="col-md-2 align-self-end">
        <button type="submit" class="btn btn-primary w-100"><i class="fa-solid fa-magnifying-glass"></i> Buscar</button>
    </div>
</form>

<table class="table table-striped table-hover">
    <tbody>
    </tbody>
</table>


<div class="d-flex justify-content-between align-items-center mt-3">
    <nav aria-label="Paginación">
        <ul class="pagination mb-0">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" asp-action="Index"
                   asp-route-q="@q" asp-route-fechaDesde="@fechaDesde?.ToString("yyyy-MM-dd")" asp-route-fechaHasta="@fechaHasta?.ToString("yyyy-MM-dd")"
                   asp-route-estado="@estado" asp-route-page="@(Model.PageIndex - 1)" asp-route-pageSize="@pageSize">Anterior</a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-q="@q" asp-route-fechaDesde="@fechaDesde?.ToString("yyyy-MM-dd")" asp-route-fechaHasta="@fechaHasta?.ToString("yyyy-MM-dd")"
                       asp-route-estado="@estado" asp-route-page="@i" asp-route-pageSize="@pageSize">@i</a>
                </li>
            }
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link" asp-action="Index"
                   asp-route-q="@q" asp-route-fechaDesde="@fechaDesde?.ToString("yyyy-MM-dd")" asp-route-fechaHasta="@fechaHasta?.ToString("yyyy-MM-dd")"
                   asp-route-estado="@estado" asp-route-page="@(Model.PageIndex + 1)" asp-route-pageSize="@pageSize">Siguiente</a>
            </li>
        </ul>
    </nav>
    <p class="text-muted mb-0">
        Mostrando @Model.Count de @Model.TotalCount eventos (página @Model.PageIndex de @Model.TotalPages).
    </p>
</div>
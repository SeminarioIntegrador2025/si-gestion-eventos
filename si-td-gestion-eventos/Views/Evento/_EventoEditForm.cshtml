@model si_td_gestion_eventos.Models.ViewModels.EventoVM
@using si_td_gestion_eventos.Models.Enums

@* ========================================
   SECCIÓN 1: INFORMACIÓN NO EDITABLE (ARRIBA)
   ======================================== *@
<div class="card mb-4 border-secondary">
    <div class="card-header bg-light">
        <h6 class="mb-0 text-muted">
            <i class="fas fa-lock me-2"></i>Información del Contrato (No Editable)
        </h6>
    </div>
    <div class="card-body bg-light">
        <div class="row">
            @* Cliente *@
            <div class="col-md-4 mb-3">
                <label class="form-label fw-semibold text-muted small">
                    <i class="fas fa-user me-1"></i>Cliente Contratante
                </label>
                <input type="hidden" asp-for="ClienteId" />
                <div class="d-flex align-items-center gap-2 px-3 py-2 rounded border bg-white">
                    <i class="fa-solid fa-lock text-muted"></i>
                    <span class="text-dark">@Model.ClienteNombreCompleto</span>
                </div>
            </div>

            @* Fecha Contrato *@
            <div class="col-md-4 mb-3">
                <label class="form-label fw-semibold text-muted small">
                    <i class="fas fa-calendar me-1"></i>Fecha del Contrato
                </label>
                <input type="hidden" asp-for="FechaContrato" />
                <div class="d-flex align-items-center gap-2 px-3 py-2 rounded border bg-white">
                    <i class="fa-solid fa-lock text-muted"></i>
                    <span class="text-dark">@Model.FechaContrato.ToString("dd/MM/yyyy")</span>
                </div>
            </div>

            @* Estado *@
            <div class="col-md-4 mb-3">
                <label class="form-label fw-semibold text-muted small">
                    <i class="fas fa-info-circle me-1"></i>Estado del Evento
                </label>
                <input type="hidden" asp-for="Estado" />
                <div class="d-flex align-items-center gap-2 px-3 py-2 rounded border bg-white">
                    <i class="fa-solid fa-lock text-muted"></i>
                    <span class="badge @(Model.Estado switch {
                        EventoEstado.PendienteAdeudado => "bg-warning text-dark",
                        EventoEstado.PendientePagado => "bg-success",
                        EventoEstado.Realizado => "bg-info",
                        EventoEstado.Cancelado => "bg-danger",
                        EventoEstado.Reprogramado => "bg-primary",
                        _ => "bg-secondary"
                    })">@Model.Estado</span>
                </div>
                <small class="text-muted d-block mt-1">
                    <i class="fas fa-tools me-1"></i>Solo editable mediante "Manipulación Manual de Estados"
                </small>
            </div>
        </div>

        <div class="row">
            @* Costo Alquiler *@
            <div class="col-md-4 mb-3 mb-md-0">
                <label class="form-label fw-semibold text-muted small">
                    <i class="fas fa-dollar-sign me-1"></i>Costo del Alquiler
                </label>
                <input type="hidden" asp-for="CostoAlquiler" />
                <div class="d-flex align-items-center gap-2 px-3 py-2 rounded border bg-white">
                    <i class="fa-solid fa-lock text-muted"></i>
                    <span class="text-dark fw-bold">@Model.CostoAlquiler.ToString("C")</span>
                </div>
            </div>

            @* Monto Reserva *@
            <div class="col-md-4 mb-3 mb-md-0">
                <label class="form-label fw-semibold text-muted small">
                    <i class="fas fa-hand-holding-dollar me-1"></i>Monto de Reserva
                </label>
                <input type="hidden" asp-for="MontoReserva" />
                <div class="d-flex align-items-center gap-2 px-3 py-2 rounded border bg-white">
                    <i class="fa-solid fa-lock text-muted"></i>
                    <span class="text-dark fw-bold">@Model.MontoReserva.ToString("C")</span>
                </div>
            </div>

            @* Placeholder para simetría *@
            <div class="col-md-4"></div>
        </div>
    </div>
</div>

@* ========================================
   SECCIÓN 2: INFORMACIÓN EDITABLE
   ======================================== *@
<h5 class="mb-3 text-primary border-bottom pb-2">
    <i class="fas fa-edit me-2"></i>Información del Evento (Editable)
</h5>

@* FECHAS Y HORAS - IGUAL QUE CREATE *@
<div class="row">
    <div class="col-md-6">
        <div class="form-group mb-3">
            <label asp-for="Inicio" class="form-label fw-bold">
                <i class="fas fa-calendar-day me-1"></i>Fecha de Inicio *
            </label>
            <input asp-for="Inicio" class="form-control" type="date" id="FechaInicio" />
            <span asp-validation-for="Inicio" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-group mb-3">
            <label asp-for="Fin" class="form-label fw-bold">
                <i class="fas fa-calendar-day me-1"></i>Fecha de Fin *
            </label>
            <input asp-for="Fin" class="form-control" type="date" id="FechaFin" />
            <span asp-validation-for="Fin" class="text-danger"></span>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="form-group mb-3">
            <label asp-for="HoraInicio" class="form-label fw-bold">
                <i class="fas fa-clock me-1"></i>Hora de Inicio *
            </label>
            <input asp-for="HoraInicio" class="form-control" type="time" id="HoraInicio"
                   value="@(Model.HoraInicio?.ToString(@"hh\:mm"))" />
            <span asp-validation-for="HoraInicio" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-group mb-3">
            <label asp-for="HoraFin" class="form-label fw-bold">
                <i class="fas fa-clock me-1"></i>Hora de Fin *
            </label>
            <input asp-for="HoraFin" class="form-control" type="time" id="HoraFin"
                   value="@(Model.HoraFin?.ToString(@"hh\:mm"))" />
            <span asp-validation-for="HoraFin" class="text-danger"></span>
        </div>
    </div>
</div>

@* TIPO Y CANTIDAD *@
<div class="row">
    <div class="col-md-6">
        <div class="form-group mb-3">
            <label asp-for="Tipo" class="form-label fw-bold">
                <i class="fas fa-tags me-1"></i>Tipo de Evento *
            </label>
            <select asp-for="Tipo" class="form-select" asp-items="Html.GetEnumSelectList<TipoEvento>()">
                <option value="">-- Seleccione un Tipo --</option>
            </select>
            <span asp-validation-for="Tipo" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-group mb-3">
            <label asp-for="CantidadPersonas" class="form-label fw-bold">
                <i class="fas fa-users me-1"></i>Cantidad de Personas *
            </label>
            <input asp-for="CantidadPersonas" class="form-control" type="number" min="50" max="400" placeholder="Ej: 50" />
            <small class="text-muted">Mínimo 50, máximo 400 personas</small>
            <span asp-validation-for="CantidadPersonas" class="text-danger"></span>
        </div>
    </div>
</div>

@* AIRE ACONDICIONADO *@
<div class="row">
    <div class="col-md-6">
        <div class="form-group mb-3">
            <label asp-for="MontoAireAcondicionado" class="form-label fw-bold">
                <i class="fas fa-snowflake me-1"></i>Monto Aire Acondicionado
            </label>
            <div class="input-group">
                <span class="input-group-text bg-light fw-bold">UYU</span>
                <input asp-for="MontoAireAcondicionado" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" />
            </div>
            <span asp-validation-for="MontoAireAcondicionado" class="text-danger"></span>
        </div>
    </div>
</div>

@* ========================================
   SECCIÓN 3: RESPONSABLE DEL SALÓN
   ======================================== *@
<hr class="my-4" />
<h5 class="mb-3 text-primary">
    <i class="fas fa-user-tie me-2"></i>Responsable del Salón
</h5>

<div class="row">
    <div class="col-md-6">
        <div class="form-group mb-3">
            <label asp-for="ResponsableCedula" class="form-label fw-bold">
                <i class="fas fa-id-card me-1"></i>Cédula del Responsable *
            </label>
            <input asp-for="ResponsableCedula" class="form-control" id="ResponsableCedula" placeholder="Ej: 1.234.567-8" maxlength="30" />
            <small class="text-muted d-block mt-1">
                <i class="fas fa-info-circle me-1"></i>Si es un Cliente registrado, los datos se autocompletarán.
            </small>
            <span asp-validation-for="ResponsableCedula" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-6"></div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="form-group mb-3">
            <label asp-for="ResponsableNombre" class="form-label fw-bold">
                <i class="fas fa-user me-1"></i>Nombre del Responsable *
            </label>
            <input asp-for="ResponsableNombre" class="form-control" id="ResponsableNombre" maxlength="100" />
            <span asp-validation-for="ResponsableNombre" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-group mb-3">
            <label asp-for="ResponsableTelefono" class="form-label fw-bold">
                <i class="fas fa-phone me-1"></i>Teléfono del Responsable *
            </label>
            <input asp-for="ResponsableTelefono" class="form-control" id="ResponsableTelefono" maxlength="30" />
            <span asp-validation-for="ResponsableTelefono" class="text-danger"></span>
        </div>
    </div>
</div>

@* ========================================
   SECCIÓN 4: OBSERVACIONES 
   ======================================== *@
<hr class="my-4" />
<h5 class="mb-3 text-primary border-bottom pb-2">
    <i class="fas fa-file-lines me-2"></i>Observaciones del Evento
</h5>

<div class="form-group mb-3">
    <label asp-for="Observaciones" class="form-label fw-bold">
        <i class="fas fa-comment-dots me-1"></i>Notas y Comentarios
    </label>
    <textarea asp-for="Observaciones" 
              class="form-control" 
              rows="6" 
              placeholder="Ingrese observaciones, cambios, o notas especiales sobre el evento...&#10;&#10;Los cambios de estado y reprogramaciones se registran automáticamente aquí."></textarea>
    <span asp-validation-for="Observaciones" class="text-danger"></span>
    <small class="text-muted d-block mt-2">
        <i class="fas fa-info-circle me-1"></i>
        Los cambios de estado realizados mediante "Manipulación Manual" y las reprogramaciones se registran automáticamente en este campo con fecha y hora.
    </small>
</div>
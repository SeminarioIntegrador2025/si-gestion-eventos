@model si_td_gestion_eventos.Models.ViewModels.EventoVM
@using si_td_gestion_eventos.Models.Enums

@{
    var isEditing = Model?.EventoId > 0;
}

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="row">
    @* --- COLUMNA IZQUIERDA: DETALLES DEL EVENTO (Esta parte estaba bien) --- *@
    <div class="col-md-6">
        <h4>Detalles del Evento</h4>
        <hr />

        <div class="mb-3">
            <label asp-for="FechaContrato" class="form-label"></label>
            <input asp-for="FechaContrato" type="date" class="form-control" readonly="@(isEditing ? "readonly" : null)" />
            <span asp-validation-for="FechaContrato" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                @* Se cambió la etiqueta para que tome el [Display] del ViewModel *@
                <label asp-for="Inicio" class="form-label"></label>
                <input asp-for="Inicio" type="date" class="form-control" />
                <span asp-validation-for="Inicio" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Fin" class="form-label"></label>
                <input asp-for="Fin" type="date" class="form-control" />
                <span asp-validation-for="Fin" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="HoraInicio" class="form-label"></label>
                <input asp-for="HoraInicio" type="time" class="form-control" />
                <span asp-validation-for="HoraInicio" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="HoraFin" class="form-label"></label>
                <input asp-for="HoraFin" type="time" class="form-control" />
                <span asp-validation-for="HoraFin" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Tipo" class="form-label"></label>
            <select asp-for="Tipo" asp-items="Html.GetEnumSelectList<TipoEvento>()" class="form-select">
                <option value="">-- Seleccione un Tipo --</option>
            </select>
            <span asp-validation-for="Tipo" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CantidadPersonas" class="form-label"></label>
            <input asp-for="CantidadPersonas" type="number" class="form-control" />
            <span asp-validation-for="CantidadPersonas" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="CostoAlquiler" class="form-label"></label>
                <input asp-for="CostoAlquiler" class="form-control" readonly="@(isEditing ? "readonly" : null)" />
                <span asp-validation-for="CostoAlquiler" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="MontoReserva" class="form-label"></label>
                <input asp-for="MontoReserva" class="form-control" readonly="@(isEditing ? "readonly" : null)" />
                <span asp-validation-for="MontoReserva" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="MontoAireAcondicionado" class="form-label"></label>
                <input asp-for="MontoAireAcondicionado" class="form-control" />
                <span asp-validation-for="MontoAireAcondicionado" class="text-danger"></span>
            </div>
        </div>
    </div>

    @* --- COLUMNA DERECHA: CLIENTE Y RESPONSABLE (Versión corregida y unificada) --- *@
    <div class="col-md-6">
        <h4>Cliente y Responsable</h4>
        <hr />

        <div class="mb-3">
            <label asp-for="ClienteId" class="form-label"></label>
            @if (isEditing)
            {
                <input type="hidden" asp-for="ClienteId" />
                <select asp-for="ClienteId" class="form-select" asp-items="ViewBag.Clientes" disabled></select>
            }
            else
            {
                <select asp-for="ClienteId" class="form-select" asp-items="ViewBag.Clientes">
                    <option value="">-- Seleccione un Cliente --</option>
                </select>
                <span asp-validation-for="ClienteId" class="text-danger"></span>
            }
        </div>

        <div class="mb-3">
            <label asp-for="ResponsableNombre" class="form-label"></label>
            <input asp-for="ResponsableNombre" class="form-control" />
            <span asp-validation-for="ResponsableNombre" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ResponsableTelefono" class="form-label"></label>
            <input asp-for="ResponsableTelefono" class="form-control" />
            <span asp-validation-for="ResponsableTelefono" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ResponsableCedula" class="form-label"></label>
            <input asp-for="ResponsableCedula" class="form-control" />
            <span asp-validation-for="ResponsableCedula" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Estado" class="form-label"></label>
            <select asp-for="Estado" asp-items="Html.GetEnumSelectList<EventoEstado>()" class="form-select"></select>
            <span asp-validation-for="Estado" class="text-danger"></span>
        </div>
    </div>
</div>
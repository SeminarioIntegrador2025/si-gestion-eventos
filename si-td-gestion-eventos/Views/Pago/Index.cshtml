@model si_td_gestion_eventos.Infrastructure.PaginatedList<si_td_gestion_eventos.Models.ViewModels.PagoVM>
@using si_td_gestion_eventos.Models.Enums

@{
    ViewData["Title"] = "Gestión de Pagos";

    bool isFilteredByEvent = (bool)ViewData["IsFilteredByEvent"];

    int totalPagosPmes = (int)ViewBag.TotalPagosPMes;
    decimal totalMontoPMes = (decimal)ViewBag.TotalMontoPMes;
    int countTransferPMes = (int)ViewBag.CountTransferenciasPMes;
    int countEfectivoPMes = (int)ViewBag.CountEfectivoPMes;

    var eventoId = ViewData["EventoId"];
    var eventoDesc = ViewData["EventoDescripcion"];
    var clienteNombre = ViewData["ClienteNombre"];
    
    //   Obtener estado del evento y permisos
    EventoEstado? estadoEvento = ViewData["EstadoEvento"] as EventoEstado?;
    bool permiteNuevoPago = (bool)(ViewData["PermiteNuevoPago"] ?? false);
    
    //   Determinar si se pueden anular/editar pagos
    bool eventoPermiteGestionar = !isFilteredByEvent || 
                                   (estadoEvento.HasValue && 
                                    estadoEvento != EventoEstado.Cancelado && 
                                    estadoEvento != EventoEstado.Realizado);

    // Query params para persistir en paginación / filtros
    string q = Context.Request.Query["q"];
    string eventoIdQuery = Context.Request.Query["eventoId"];
    int pageSize = int.TryParse(Context.Request.Query["pageSize"], out var ps) ? ps : 10;
}

<div class="page-header d-flex align-items-start justify-content-between flex-wrap gap-3">
    <div>
        <h1 class="page-title mb-1">
            <i class="fa-solid fa-dollar-sign text-primary me-3"></i>Gestión de Pagos
        </h1>
        @if (isFilteredByEvent)
        {
            <h5 class="text-muted fw-normal mb-0">
                Mostrando pagos para: <strong>@eventoDesc</strong> (@clienteNombre)
            </h5>
        }
    </div>

    @*   FIX: Ocultar botón "Nuevo Pago" si el evento está finalizado *@
    @if (!isFilteredByEvent || (isFilteredByEvent && permiteNuevoPago))
    {
        <div class="ms-auto d-flex gap-2">
            <a class="btn btn-success" asp-action="Create" asp-route-eventoId="@eventoId">
                <i class="fa-solid fa-plus me-2"></i>Nuevo Pago
            </a>
        </div>
    }
    else if (isFilteredByEvent && !permiteNuevoPago)
    {
        <div class="ms-auto">
            <div class="alert alert-warning mb-0 py-2 px-3">
                <i class="fa-solid fa-ban me-2"></i>
                @if (estadoEvento == EventoEstado.Cancelado || estadoEvento == EventoEstado.Realizado)
                {
                    <span>No se pueden agregar pagos a eventos finalizados.</span>
                }
                else
                {
                    <span>El evento está completamente pagado.</span>
                }
            </div>
        </div>
    }
</div>

@*   Mostrar alertas solo si tienen contenido *@
@if (TempData["Ok"] != null && !string.IsNullOrWhiteSpace(TempData["Ok"]?.ToString()))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-check-circle me-2"></i> @TempData["Ok"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null && !string.IsNullOrWhiteSpace(TempData["Error"]?.ToString()))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <div class="col-xl-9 col-lg-8">

        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card card-kpi text-center">
                    <div class="card-body">
                        <div class="card-title mb-1">Monto Generado (Mes)</div>
                        <div class="h3 text-primary fw-bold">@totalMontoPMes.ToString("N1")</div>
                        <small class="text-muted">Solo pagos válidos</small>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card card-kpi text-center">
                    <div class="card-body">
                        <div class="card-title mb-1"># Pagos (Mes)</div>
                        <div class="display-6 text-info fw-bold">@totalPagosPmes</div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card card-kpi text-center">
                    <div class="card-body">
                        <div class="card-title mb-1"># Transferencias</div>
                        <div class="display-6 text-success fw-bold">@countTransferPMes</div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card card-kpi text-center">
                    <div class="card-body">
                        <div class="card-title mb-1"># Efectivo</div>
                        <div class="display-6 text-warning fw-bold">@countEfectivoPMes</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <form method="get" class="row g-3 align-items-end">
                    <input type="hidden" name="page" value="1" />

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            <i class="fa-solid fa-magnifying-glass me-1"></i>Buscar Pago
                        </label>
                        <input name="q" class="form-control"
                               placeholder="Cliente, evento, referencia..."
                               value="@q" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold">
                            <i class="fa-solid fa-filter me-1"></i>Filtrar por Evento
                        </label>
                        <select name="eventoId" class="form-select" asp-items="@ViewBag.EventosFilter">
                            <option value="">Todos los eventos</option>
                        </select>
                    </div>

                    <div class="col-md-1">
                        <label class="form-label fw-semibold">Mostrar</label>
                        <select name="pageSize" class="form-select" onchange="this.form.submit()">
                            @foreach (var s in new[] { 10, 25, 50 })
                            {
                                <option value="@s" selected="@(s == pageSize)">@s</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4 d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-fill">
                            <i class="fa-solid fa-search me-1"></i>
                            <span class="d-none d-lg-inline">Buscar</span>
                        </button>

                        <a class="btn btn-outline-secondary flex-shrink-0"
                           asp-action="Index"
                           asp-route-page="1"
                           asp-route-pageSize="@pageSize"
                           title="Limpiar filtros y recargar"
                           aria-label="Limpiar todos los filtros"
                           style="min-width: 42px;">
                            <i class="fa-solid fa-rotate-left"></i>
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="fa-solid fa-table me-2"></i>Lista de Pagos</span>
                <span class="badge bg-primary">@Model.TotalCount pagos</span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            @if (!isFilteredByEvent)
                            {
                                <th><i class="fa-solid fa-user me-1"></i>Cliente</th>
                                <th><i class="fa-solid fa-calendar me-1"></i>Evento</th>
                            }
                            <th>Fecha</th>
                            <th>Monto</th>
                            <th>Método</th>
                            <th>Observaciones</th>
                            <th>Comprobante</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var pago in Model)
                            {
                                string rowClass = pago.Valido ? "" : "table-active text-muted text-decoration-line-through";

                                <tr class="@rowClass">
                                    @if (!isFilteredByEvent)
                                    {
                                        <td>@pago.ClienteNombre</td>
                                        <td>@pago.EventoDescripcion</td>
                                    }

                                    <td>@pago.Fecha.ToString("dd/MM/yyyy")</td>

                                    <td>
                                        <span class="fw-bold">@pago.Monto.ToString("C")</span>
                                        @if (!pago.Valido)
                                        {
                                            <span class="badge bg-danger ms-1 text-decoration-none" style="opacity: 1;">ANULADO</span>
                                        }
                                    </td>

                                    <td>@Html.DisplayFor(_ => pago.Metodo)</td>
                                    <td class="small">@pago.Observaciones</td>

                                    <td>
                                        @if (!string.IsNullOrEmpty(pago.RutaArchivoExistente))
                                        {
                                            <a href="@pago.RutaArchivoExistente" target="_blank" class="btn btn-sm btn-info" title="Ver comprobante">
                                                <i class="fas fa-file-alt"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>

                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            @*   FIX: Ocultar botón EDITAR si el evento está finalizado *@
                                            @if (pago.Valido && eventoPermiteGestionar)
                                            {
                                                <a asp-action="Edit" asp-route-id="@pago.PagoId" 
                                                   class="btn btn-sm btn-outline-secondary" 
                                                   title="Editar">
                                                    <i class="fa-solid fa-pen"></i>
                                                </a>
                                            }
                                            else if (pago.Valido && !eventoPermiteGestionar)
                                            {
                                                <button class="btn btn-sm btn-secondary disabled" 
                                                        title="No se pueden editar pagos de eventos finalizados" 
                                                        disabled>
                                                    <i class="fa-solid fa-pen"></i>
                                                </button>
                                            }

                                            @if (pago.Valido)
                                            {
                                                <a asp-action="DescargarRecibo" asp-route-pagoId="@pago.PagoId" 
                                                   class="btn btn-sm btn-outline-info" 
                                                   title="Descargar Recibo">
                                                    <i class="fa-solid fa-file-pdf"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-secondary disabled" 
                                                        title="No disponible para pagos anulados" 
                                                        disabled>
                                                    <i class="fa-solid fa-file-pdf"></i>
                                                </button>
                                            }

                                            @*   Botón ANULAR - ya estaba bien implementado *@
                                            @if (pago.Valido && eventoPermiteGestionar)
                                            {
                                                <form asp-action="Anular" asp-route-id="@pago.PagoId" method="post" class="d-inline"
                                                      onsubmit="return confirm('ATENCIÓN: ¿Está seguro de anular este pago?\n\nEl monto se restará del total pagado del evento y el saldo pendiente aumentará.');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Anular Pago">
                                                        <i class="fa-solid fa-trash"></i>
                                                    </button>
                                                </form>
                                            }
                                            else if (pago.Valido && !eventoPermiteGestionar)
                                            {
                                                <button class="btn btn-sm btn-secondary disabled" 
                                                        title="No se pueden anular pagos de eventos finalizados" 
                                                        disabled>
                                                    <i class="fa-solid fa-ban"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-secondary disabled" title="Ya anulado" disabled>
                                                    <i class="fa-solid fa-ban"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="@(isFilteredByEvent ? 6 : 8)" class="text-center py-5">
                                    <div class="text-muted">
                                        <i class="fa-solid fa-search-dollar fa-3x mb-3 d-block"></i>
                                        <h5>No se encontraron pagos</h5>
                                        <p>Intenta ajustar los filtros o <a asp-action="Create" class="text-decoration-none">agregar un nuevo pago</a>.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
                <small class="text-muted">
                    Página @Model.PageIndex de @Model.TotalPages (@Model.TotalCount resultados)
                </small>

                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Paginación">
                        <ul class="pagination mb-0">
                            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-eventoId="@(isFilteredByEvent ? eventoId : eventoIdQuery)"
                                   asp-route-q="@q"
                                   asp-route-page="@(Model.PageIndex - 1)"
                                   asp-route-pageSize="@pageSize">
                                    <i class="fas fa-chevron-left me-1"></i>Anterior
                                </a>
                            </li>

                            @for (int i = Model.StartPage; i <= Model.EndPage; i++)
                            {
                                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-eventoId="@(isFilteredByEvent ? eventoId : eventoIdQuery)"
                                       asp-route-q="@q"
                                       asp-route-page="@i"
                                       asp-route-pageSize="@pageSize">@i</a>
                                </li>
                            }

                            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-eventoId="@(isFilteredByEvent ? eventoId : eventoIdQuery)"
                                   asp-route-q="@q"
                                   asp-route-page="@(Model.PageIndex + 1)"
                                   asp-route-pageSize="@pageSize">
                                    Siguiente<i class="fas fa-chevron-right ms-1"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-lg-4">
        <div class="card mb-4">
            <div class="card-header d-flex align-items-center justify-content-between">
                <span><i class="fa-solid fa-clock-rotate-left me-2"></i>Últimos pagos</span>
                @if (!isFilteredByEvent || (isFilteredByEvent && permiteNuevoPago))
                {
                    <a asp-action="Create" class="btn btn-sm btn-accent"><i class="fa-solid fa-plus me-1"></i>Nuevo</a>
                }
            </div>

            <div class="list-group list-group-flush">
                @foreach (var p in Model.OrderByDescending(x => x.PagoId).Take(5))
                {
                    string itemClass = p.Valido
                    ? "list-group-item list-group-item-action"
                    : "list-group-item list-group-item-action list-group-item-light text-muted";

                    <a class="@itemClass" href="#">
                        <div class="d-flex justify-content-between">
                            <div>
                                <div class="fw-semibold @(!p.Valido ? "text-decoration-line-through" : "")">
                                    @p.Monto.ToString("C")
                                </div>
                                <small class="text-muted">@p.ClienteNombre</small>
                            </div>
                            <div class="text-end">
                                <small class="text-muted d-block">@p.Fecha.ToString("dd/MM")</small>
                                @if (!p.Valido)
                                {
                                    <span class="badge bg-danger" style="font-size: 0.6rem;"> Anulado </span>
                                }
                            </div>
                        </div>
                    </a>
                }
            </div>
        </div>
    </div>
</div>

@if (isFilteredByEvent)
{
    <div class="mt-4">
        <a asp-controller="Evento" asp-action="Details" asp-route-id="@eventoId" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-2"></i>Volver al Evento
        </a>
    </div>
}

@model si_td_gestion_eventos.Models.ViewModels.PagoReservaVM
@{
    ViewData["Title"] = "Confirmar Reserva de Evento";
}

<h2>Paso 2: Confirmar Pago de Reserva</h2>
<p>Complete los datos del pago para confirmar la creación del evento.</p>
<hr />

<div class="row">
    <div class="col-md-7">

        <form asp-action="CreateReserva" method="post" enctype="multipart/form-data">

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <fieldset class="mb-3">
                <legend style="font-size: 1.1em;">Datos de la Reserva (Bloqueados)</legend>
                <div class="form-group mb-2">
                    <label asp-for="Monto" class="control-label"></label>
                    <input asp-for="Monto" class="form-control" readonly />
                </div>
                <div class="form-group mb-2">
                    <label asp-for="Fecha" class="control-label"></label>
                    <input asp-for="Fecha" class="form-control" readonly />
                </div>
            </fieldset>

            <fieldset>
                <legend style="font-size: 1.1em;">Complete el Pago</legend>
                <div class="form-group mb-3">
                    <label asp-for="Metodo" class="control-label">Método de Pago</label>
                    <select asp-for="Metodo" class="form-select" asp-items="Html.GetEnumSelectList<si_td_gestion_eventos.Models.Enums.MetodoPago>()">
                        <option value="">-- Seleccionar --</option>
                    </select>
                    <span asp-validation-for="Metodo" class="text-danger"></span>
                </div>
                <div class="form-group mb-2">
                    <label asp-for="Observaciones" class="control-label"></label>

                    <input asp-for="Observaciones" type="text" class="form-control" id="observacionesInput" />

                </div>
                <div class="form-group mb-3">
                    <label asp-for="ArchivoComprobante" class="control-label"></label>
                    <input asp-for="ArchivoComprobante" type="file" class="form-control" />
                </div>
            </fieldset>

            <div class="form-group mt-4">
                <input type="submit" value="Confirmar y Guardar Evento" class="btn btn-success" />
                <a id="btnCancelar" href="@Url.Action("CancelCreate", "Pago")" class="btn btn-danger">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.getElementById("btnCancelar").addEventListener("click", function(e) {
            e.preventDefault();
            if (confirm("Si cancela, se perderán los datos del evento y no podrá darse de alta. ¿Está seguro?")) {
                window.location.href = this.href;
            }
        });
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {

            const obsInput = document.getElementById("observacionesInput");
            if (!obsInput) return; // Salir si no se encuentra

            const prefix = obsInput.value;

            // --- El resto del script es para proteger ese prefijo ---

            obsInput.addEventListener("focus", function() {
                if(obsInput.value === prefix) {
                    obsInput.value = prefix + " "; // Añade un espacio para escribir
                    obsInput.setSelectionRange(obsInput.value.length, obsInput.value.length);
                }
            });

            obsInput.addEventListener("keydown", function(e) {
                const cursorPosition = e.target.selectionStart;
                const prefixLength = prefix.length;

                if (e.key === "Backspace" && cursorPosition <= prefixLength) {
                    e.preventDefault();
                }

                if (e.key === "Delete" && cursorPosition < prefixLength) {
                    e.preventDefault();
                }
            });

            obsInput.addEventListener("cut", function(e) {
                if (e.target.selectionStart < prefix.length) {
                    e.preventDefault();
                }
            });

             obsInput.addEventListener("paste", function(e) {
                if (e.target.selectionStart < prefix.length) {
                    e.preventDefault();
                }
            });

            obsInput.addEventListener("input", function(e) {
                if (!e.target.value.startsWith(prefix)) {
                    // Si el usuario logra borrarlo, lo resetea
                    e.target.value = prefix + " ";
                }
            });
        });
    </script>
}
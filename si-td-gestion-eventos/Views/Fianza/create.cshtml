@model si_td_gestion_eventos.Models.ViewModels.FianzaVM
@{
    ViewData["Title"] = "Registrar Fianza";
}

<div class="container-fluid">
    <div class="page-header mb-4">
        <h2 class="page-title">
            <i class="fas fa-shield-alt me-3 text-warning"></i>Registrar Fianza
        </h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Evento" asp-action="Index">Eventos</a></li>
                @if (ViewBag.EventoPreseleccionado == true)
                {
                    <li class="breadcrumb-item"><a asp-controller="Evento" asp-action="Details" asp-route-id="@Model.EventoId">Detalles del Evento</a></li>
                }
                else
                {
                    <li class="breadcrumb-item"><a asp-controller="Fianza" asp-action="Index">Fianzas</a></li>
                }
                <li class="breadcrumb-item active">Registrar Fianza</li>
            </ol>
        </nav>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-secondary bg-transparent">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">
                        <i class="fas fa-shield-alt me-2"></i>Datos de la Fianza
                    </h5>
                </div>

                <form asp-action="Create" method="post">
                    <div class="card-body p-4 border border-top-0 border-secondary rounded-bottom">

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-group mb-4">
                            <label class="form-label fw-bold">Evento Asociado</label>

                            @if (ViewBag.EventoPreseleccionado == true)
                            {
                                <input class="form-control border-secondary text-white bg-dark" value="@Model.EventoDescripcion" disabled />
                                <input type="hidden" asp-for="EventoId" />
                            }
                            else
                            {
                                @* Agregamos la clase select2-busqueda para activar el buscador *@
                                <select asp-for="EventoId"
                                        asp-items="@(ViewBag.EventosDisponibles as IEnumerable<SelectListItem>)"
                                        class="form-select select2-busqueda">
                                    <option value="">-- Escriba para buscar evento o cliente... --</option>
                                </select>
                                <span asp-validation-for="EventoId" class="text-danger"></span>
                            }
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Monto" class="form-label fw-semibold"></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-transparent text-white fw-bold border-secondary">UYU</span>
                                        <input asp-for="Monto"
                                               class="form-control border-secondary text-white"
                                               type="number"
                                               step="0.01" />
                                    </div>
                                    <span asp-validation-for="Monto" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="FechaRegistro" class="form-label fw-semibold"></label>
                                    <input asp-for="FechaRegistro" class="form-control border-secondary text-white" type="date" />
                                    <span asp-validation-for="FechaRegistro" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Observaciones" class="form-label fw-semibold"></label>
                            <textarea asp-for="Observaciones" class="form-control border-secondary text-white" rows="3" placeholder="Notas adicionales sobre el depósito..."></textarea>
                            <span asp-validation-for="Observaciones" class="text-danger"></span>
                        </div>

                    </div>

                    <div class="card-footer bg-transparent d-flex justify-content-between align-items-center p-4 border-top border-secondary">
                        @if (ViewBag.EventoPreseleccionado == true)
                        {
                            <a asp-controller="Evento" asp-action="Details" asp-route-id="@Model.EventoId" class="btn btn-outline-secondary">
                                <i class="fas fa-times me-2"></i>Cancelar
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Fianza" asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-times me-2"></i>Cancelar
                            </a>
                        }

                        <button type="submit" class="btn btn-success btn-lg px-5 shadow-sm">
                            <i class="fas fa-save me-2"></i>Guardar Fianza
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function() {
            // Inicialización de Select2 con el tema de Bootstrap 5
            $('.select2-busqueda').select2({
                theme: 'bootstrap-5',
                width: '100%',
                placeholder: '-- Escriba para buscar evento o cliente... --',
                language: {
                    noResults: function() {
                        return "No se encontraron eventos pendientes de fianza";
                    }
                }
            });
        });
    </script>
}
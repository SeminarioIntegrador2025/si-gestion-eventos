@using si_td_gestion_eventos.Models.Enums
@model si_td_gestion_eventos.Models.ViewModels.FianzaVM

@{
    ViewData["Title"] = "Detalles de la Fianza";
}

<div class="container-fluid">
    <div class="page-header mb-4">
        <h2 class="page-title">
            <i class="fas fa-info-circle me-3 text-info"></i>Detalles de la Fianza
        </h2>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-secondary">
                <div class="card-header border-bottom border-secondary d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fas fa-file-invoice-dollar me-2"></i>Información Registrada
                    </h5>
                    @{
                        string badgeClass = Model.Estado switch
                        {
                            EstadoFianza.Registrada => "bg-primary",
                            EstadoFianza.DevueltaTotalmente => "bg-success",
                            EstadoFianza.DevueltaParcialmente => "bg-warning text-dark",
                            EstadoFianza.NoDevuelta => "bg-danger",
                            _ => "bg-secondary"
                        };
                    }
                    <span class="badge @badgeClass fs-6">@Html.DisplayFor(m => m.Estado)</span>
                </div>

                <div class="card-body p-4">

                    <div class="p-3 mb-4 rounded border border-success text-ligth d-flex justify-content-between align-items-center">
                        <div>
                            <strong><i class="fas fa-info-circle"></i> Evento Asociado:</strong>
                            @Model.ClienteNombre - @Model.EventoFecha.ToShortDateString()
                        </div>
                        <a asp-controller="Evento" asp-action="Details" asp-route-id="@Model.EventoId" class="btn btn-sm btn-outline-light">
                            Ver Evento <i class="fas fa-external-link-alt ms-1"></i>
                        </a>
                    </div>

                    <div class="row">
                        <div class="col-md-6 border-end border-secondary">
                            <h6 class="text-muted border-bottom border-secondary pb-2 mb-3">Cobro Original</h6>
                            <dl class="row">
                                <dt class="col-sm-5">Monto:</dt>
                                <dd class="col-sm-7 fw-bold">$ @Model.Monto.ToString("N2")</dd>

                                <dt class="col-sm-5">Fecha Cobro:</dt>
                                <dd class="col-sm-7">@Model.FechaRegistro.ToShortDateString()</dd>
                            </dl>
                        </div>

                        <div class="col-md-6">
                            <h6 class="text-muted border-bottom border-secondary pb-2 mb-3">Devolución</h6>
                            @if (Model.MontoDevuelto.HasValue)
                            {
                                <dl class="row">
                                    <dt class="col-sm-5 text-warning">Devuelto:</dt>
                                    <dd class="col-sm-7 fw-bold text-warning">$ @Model.MontoDevuelto.Value.ToString("N2")</dd>

                                    <dt class="col-sm-5">Fecha:</dt>
                                    <dd class="col-sm-7">@(Model.FechaDevolucion?.ToShortDateString() ?? "-")</dd>
                                </dl>
                            }
                            else
                            {
                                <p class="text-muted fst-italic">Aún no se ha registrado devolución.</p>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Observaciones))
                    {
                        <div class="mt-4">
                            <h6 class="text-muted border-bottom border-secondary pb-2">Observaciones</h6>
                            <div class="p-3 rounded bg-dark border border-secondary text-white">
                                @Model.Observaciones
                            </div>
                        </div>
                    }

                </div>

                <div class="card-footer">
                    @{
                        var returnUrl = Context.Request.Query["returnUrl"].ToString();
                    }

                    @if (!string.IsNullOrEmpty(returnUrl))
                    {
                        <a href="@returnUrl" class="btn btn-secondary">
                            <i class="fa-solid fa-arrow-left me-2"></i>Volver al Evento
                        </a>
                    }
                    else
                    {
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fa-solid fa-arrow-left me-2"></i>Volver a Fianzas
                        </a>
                    }
    
                    <a asp-action="Edit" asp-route-id="@Model.FianzaId" class="btn btn-warning">
                        <i class="fa-solid fa-pen me-2"></i>Gestionar Devolución
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
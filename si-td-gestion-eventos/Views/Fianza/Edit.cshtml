@using si_td_gestion_eventos.Models.Enums
@model si_td_gestion_eventos.Models.ViewModels.FianzaVM

@{
    ViewData["Title"] = "Gestionar Devolución de Fianza";
}

<div class="container-fluid">
    <div class="page-header mb-4">
        <div>
            <h2 class="page-title">
                <i class="fas fa-hand-holding-usd me-3 text-warning"></i>Gestionar Devolución de Fianza
            </h2>
            <p class="text-muted">@Model.EventoDescripcion</p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">
                        <i class="fas fa-edit me-2"></i>Editar Fianza
                    </h5>
                </div>

                <form asp-action="Edit" method="post" id="formFianza">
                    <div class="card-body p-4">

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <input type="hidden" asp-for="FianzaId" />
                        <input type="hidden" asp-for="EventoId" />

                        <div class="alert alert-info border-0 mb-4">
                            <div class="row">
                                <div class="col-md-4">
                                    <strong>Monto Original:</strong><br />
                                    <span class="fs-5">@Model.Monto.ToString("C2")</span>
                                </div>
                                <div class="col-md-4">
                                    <strong>Estado Actual:</strong><br />
                                    <span class="badge bg-primary fs-6">@Model.Estado</span>
                                </div>
                                <div class="col-md-4">
                                    <strong>Fecha de Registro:</strong><br />
                                    @Model.FechaRegistro.ToShortDateString()
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="MontoDevuelto" class="form-label fw-semibold">Monto a Devolver</label>

                                    <div class="input-group">
                                        <span class="input-group-text bg-transparent text-light fw-bold border-secondary">UYU</span>
                                        <input asp-for="MontoDevuelto"
                                               class="form-control"
                                               type="number"
                                               step="0.01"
                                               placeholder="0.00" />
                                    </div>

                                    <span asp-validation-for="MontoDevuelto" class="text-danger"></span>
                                    <small class="form-text text-muted">Monto máximo: @Model.Monto.ToString("C2")</small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="FechaDevolucion" class="form-label fw-semibold">Fecha de Devolución</label>
                                    <input asp-for="FechaDevolucion"
                                           class="form-control"
                                           type="date"
                                           id="fechaDevolucion" />
                                    <span asp-validation-for="FechaDevolucion" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Observaciones" class="form-label fw-semibold">Observaciones</label>
                            <textarea asp-for="Observaciones" class="form-control" rows="3" placeholder="Ej: Devolución completa, sin daños..."></textarea>
                            <span asp-validation-for="Observaciones" class="text-danger"></span>
                        </div>

                    </div>

                    <div class="card-footer bg-transparent d-flex justify-content-between align-items-center p-4 border-top">
                        <a asp-controller="Fianza" asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Cancelar
                        </a>

                        <button type="submit" class="btn btn-warning btn-lg text-dark">
                            <i class="fas fa-save me-2"></i>Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const fechaInput = document.getElementById('fechaDevolucion');

            // Establecer fecha de hoy por defecto si está vacío
            if (fechaInput && !fechaInput.value) {
                const hoy = new Date();
                fechaInput.value = hoy.toISOString().split('T')[0];
            }
        });
    </script>
}
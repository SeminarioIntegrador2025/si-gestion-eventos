@using si_td_gestion_eventos.Models.Enums
@model si_td_gestion_eventos.Models.ViewModels.FianzaVM

@{
    ViewData["Title"] = "Gestionar Fianza";
}

<div class="container-fluid">
    <div class="page-header mb-4">
        <h2 class="page-title">
            <i class="fas fa-edit me-3 text-warning"></i>Gestionar / Devolver Fianza
        </h2>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-secondary">
                <div class="card-header border-bottom border-secondary">
                    <h5 class="mb-0">
                        <i class="fas fa-file-invoice-dollar me-2"></i>Detalles de la Fianza
                    </h5>
                </div>

                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="FianzaId" />
                    <input type="hidden" asp-for="EventoId" />
                    <input type="hidden" asp-for="EventoDescripcion" />

                    <div class="card-body p-4">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="p-3 mb-4 rounded border border-success text-ligth">
                            <strong><i class="fas fa-info-circle"></i> Evento Asociado:</strong>
                            @Model.ClienteNombre - @Model.EventoFecha.ToShortDateString()
                        </div>

                        <h6 class="text-muted border-bottom border-secondary pb-2 mb-3">
                            Datos Originales <small>(Editar solo si hubo error)</small>
                        </h6>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Monto" class="form-label fw-bold">Monto Original Cobrado ($)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-secondary text-white border-secondary">$</span>
                                    <input asp-for="Monto" class="form-control" type="number" step="0.01" />
                                </div>
                                <span asp-validation-for="Monto" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="FechaRegistro" class="form-label">Fecha de Cobro</label>
                                <input asp-for="FechaRegistro" class="form-control" type="date" />
                                <span asp-validation-for="FechaRegistro" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="card border-warning mb-3 mt-4" style="background-color: transparent;">
                            <div class="card-header bg-warning text-dark fw-bold">
                                <i class="fas fa-hand-holding-usd me-2"></i>Registrar Devolución al Cliente
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <label asp-for="MontoDevuelto" class="form-label fw-bold">Monto a Devolver ($)</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-warning text-dark border-warning">$</span>
                                            <input asp-for="MontoDevuelto" class="form-control border-warning" type="number" step="0.01" placeholder="0.00" />
                                        </div>
                                        <span asp-validation-for="MontoDevuelto" class="text-danger"></span>
                                        <small class="text-muted">
                                            Si devuelve todo, ingrese el mismo valor que el original.
                                        </small>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="FechaDevolucion" class="form-label">Fecha de Devolución</label>
                                        <input asp-for="FechaDevolucion" class="form-control" type="date" />
                                        <span asp-validation-for="FechaDevolucion" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Observaciones" class="form-label">Observaciones / Motivo de descuento</label>
                            <textarea asp-for="Observaciones" class="form-control" rows="3" placeholder="Ej: Se descontaron $500 por rotura de vidrio..."></textarea>
                            <span asp-validation-for="Observaciones" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="card-footer border-top border-secondary d-flex justify-content-between align-items-center p-4">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Cancelar
                        </a>
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="fas fa-save me-2"></i>Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
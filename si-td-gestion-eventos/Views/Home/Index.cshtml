@using si_td_gestion_eventos.Models.ViewModels
@{
    ViewData["Title"] = "Inicio";
    var reportes = ViewBag.Reportes as ReportesVM;
    var proximosEventos = ViewBag.ProximosEventos as List<EventoVM> ?? new List<EventoVM>();
    var alertasAgadu = ViewBag.AlertasServicios as IEnumerable<EventoVM>;
}

<div>
    <div class="container-fluid">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h1 class="h4 mb-0">Panel general</h1>
            <div class="d-flex gap-2">
                <a class="btn btn-sm btn-primary" asp-controller="Reporte" asp-action="Index">
                    <i class="fa-solid fa-chart-line me-1"></i>
                    Ver reportes completos
                </a>
            </div>
        </div>

        @if (alertasAgadu != null && alertasAgadu.Any())
        {
            <div class="alert alert-danger border-danger shadow-sm mb-4">
                <div class="d-flex align-items-start">
                    <div class="me-3 mt-1">
                        <i class="fas fa-exclamation-triangle fa-2x text-danger"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h4 class="alert-heading fs-5 fw-bold text-danger">
                            ¡Acción Requerida! Faltan Servicios Esenciales
                        </h4>
                        <p class="mb-2 text-dark">
                            Los siguientes eventos comienzan en menos de 48hs y <strong>no tienen los servicios esenciales verificados</strong>.
                        </p>

                        <div class="table-responsive bg-transparent rounded border border-danger-subtle">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="table-light text-danger">
                                    <tr>
                                        <th>Cliente</th>
                                        <th>Tipo Evento</th>
                                        <th>Fecha Inicio</th>
                                        <th class="text-end">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var evento in alertasAgadu)
                                    {
                                        <tr>
                                            <td class="align-middle">@evento.ClienteNombreCompleto</td>
                                            <td class="align-middle">@evento.Tipo</td>
                                            <td class="align-middle fw-bold text-danger">
                                                @evento.Inicio.ToString("dd/MM/yyyy HH:mm")
                                            </td>
                                            <td class="text-end">
                                                <a asp-controller="Evento" asp-action="Details" asp-route-id="@evento.EventoId"
                                                   class="btn btn-sm btn-outline-secondary me-1">
                                                    <i class="fas fa-eye"></i> Gestionar
                                                </a>

                                                <a asp-controller="Evento" asp-action="Cancel" asp-route-id="@evento.EventoId"
                                                   class="btn btn-sm btn-danger text-white">
                                                    <i class="fas fa-ban me-1"></i> Cancelar
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }
        @if (reportes != null)
        {
            <div class="row g-3">
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card card-kpi p-3">
                        <div class="card-title">Eventos del mes</div>
                        <div class="d-flex align-items-baseline gap-2">
                            <span class="display-6 fw-semibold">@reportes.Eventos.EventosEsteMes</span>
                            @if (reportes.Eventos.CrecimientoPositivo)
                            {
                                <span class="text-success small">
                                    <i class="fa-solid fa-arrow-up-right me-1"></i>
                                    +@reportes.Eventos.PorcentajeCambioEventos%
                                </span>
                            }
                            else
                            {
                                <span class="text-danger small">
                                    <i class="fa-solid fa-arrow-down-right me-1"></i>
                                    @reportes.Eventos.PorcentajeCambioEventos%
                                </span>
                            }
                        </div>
                        <div class="small text-muted">vs. mes anterior (@reportes.Eventos.EventosMesAnterior)</div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card card-kpi p-3">
                        <div class="card-title">Ingresos recibidos (UYU)</div>
                        <div class="d-flex align-items-baseline gap-2">
                            <span class="display-6 fw-semibold">$ @reportes.Ingresos.TotalIngresosEsteMes.ToString("N0")</span>
                            @if (reportes.Ingresos.CrecimientoPositivo)
                            {
                                <span class="text-success small">
                                    <i class="fa-solid fa-arrow-up-right me-1"></i>
                                    +@reportes.Ingresos.PorcentajeCambioIngresos%
                                </span>
                            }
                            else
                            {
                                <span class="text-danger small">
                                    <i class="fa-solid fa-arrow-down-right me-1"></i>
                                    @reportes.Ingresos.PorcentajeCambioIngresos%
                                </span>
                            }
                        </div>
                        <div class="small text-muted">Este mes</div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card card-kpi p-3">
                        <div class="card-title">Adeudos pendientes</div>
                        <div class="display-6 fw-semibold text-warning">$ @reportes.Pagos.TotalAdeudado.ToString("N0")</div>
                        <div class="small text-muted">@reportes.Pagos.EventosConAdeudo evento(s) adeudado(s)</div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card card-kpi p-3">
                        <div class="card-title">Clientes activos</div>
                        <div class="display-6 fw-semibold">@reportes.Clientes.ClientesActivos</div>
                        <div class="small text-muted">
                            Total: @reportes.Clientes.TotalClientes |
                            Promedio: @reportes.Clientes.PromedioEventosPorCliente eventos/cliente
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="fa-solid fa-info-circle me-2"></i>
                Cargando información del dashboard...
            </div>
        }

        <div class="card mt-4">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h2 class="h6 mb-0">
                        <i class="fa-solid fa-calendar-days me-2 text-primary"></i>
                        Próximos eventos
                    </h2>
                    <a class="btn btn-sm btn-outline-secondary" asp-controller="Evento" asp-action="Index">
                        Ver todos <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                </div>

                @if (proximosEventos.Any())
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Cliente</th>
                                    <th>Tipo</th>
                                    <th class="text-center">Personas</th>
                                    <th class="text-center">Estado</th>
                                    <th class="text-end">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var evento in proximosEventos)
                                {
                                    <tr>
                                        <td class="table-date">
                                            <strong>@evento.Inicio.ToString("dd/MM")</strong>
                                            <small class="d-block text-muted">@evento.HoraInicio.ToString(@"hh\:mm")</small>
                                        </td>
                                        <td>
                                            <strong>@evento.ClienteNombreCompleto</strong>
                                        </td>
                                        <td>
                                            <span class="badge bg-info-subtle text-info">
                                                @evento.Tipo?.ToString()
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <i class="fa-solid fa-users text-muted me-1"></i>
                                            @evento.CantidadPersonas
                                        </td>
                                        <td class="text-center">
                                            @switch (evento.Estado)
                                            {
                                                case si_td_gestion_eventos.Models.Enums.EventoEstado.PendientePagado:
                                                    <span class="badge bg-success">Pagado</span>
                                                    break;
                                                case si_td_gestion_eventos.Models.Enums.EventoEstado.PendienteAdeudado:
                                                    <span class="badge bg-warning">Adeudado</span>
                                                    break;
                                                case si_td_gestion_eventos.Models.Enums.EventoEstado.Realizado:
                                                    <span class="badge bg-primary">Realizado</span>
                                                    break;
                                                case si_td_gestion_eventos.Models.Enums.EventoEstado.Reprogramado:
                                                    <span class="badge bg-secondary">Reprogramado</span>
                                                    break;
                                                case si_td_gestion_eventos.Models.Enums.EventoEstado.Cancelado:
                                                    <span class="badge bg-danger">Cancelado</span>
                                                    break;
                                                default:
                                                    <span class="badge bg-secondary">@evento.Estado</span>
                                                    break;
                                            }
                                        </td>
                                        <td class="text-end">
                                            <a class="btn btn-sm btn-outline-secondary"
                                               asp-controller="Evento"
                                               asp-action="Details"
                                               asp-route-id="@evento.EventoId"
                                               title="Ver detalles">
                                                <i class="fa-regular fa-eye"></i>
                                            </a>
                                            <a class="btn btn-sm btn-outline-secondary"
                                               asp-controller="Evento"
                                               asp-action="Edit"
                                               asp-route-id="@evento.EventoId"
                                               title="Editar">
                                                <i class="fa-regular fa-pen-to-square"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fa-solid fa-calendar-xmark fa-3x text-muted mb-3"></i>
                        <p class="text-muted mb-3">No hay eventos próximos programados</p>
                        <a class="btn btn-primary" asp-controller="Evento" asp-action="Create">
                            <i class="fa-solid fa-plus me-2"></i>
                            Crear primer evento
                        </a>
                    </div>
                }
            </div>
        </div>

        <div class="text-center mt-4">
            <h2 class="h5 mb-2">
                <i class="fa-solid fa-champagne-glasses me-2 text-primary"></i>
                Tata David - Fiestas y Eventos
            </h2>
            <p class="text-muted">
                <i class="fa-brands fa-instagram me-1"></i>
                <a href="https://www.instagram.com/tata_david_?utm_source=ig_web_button_share_sheet&igsh=ZDNlZDc0MzIxNw==" target="_blank" class="text-decoration-none">Instagram</a>
            </p>
            <p class="text-muted">
                <i class="fa-brands fa-facebook me-1"></i>
                <a href="https://www.facebook.com/tata.david.5815" target="_blank" class="text-decoration-none">Facebook</a>
            </p>
        </div>
    </div>
</div>

<style>
    .card-kpi {
        border-left: 4px solid var(--primary);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .card-kpi:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px var(--shadow);
        }

        .card-kpi .card-title {
            font-size: 0.875rem;
            font-weight: 600;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 0.75rem;
        }

    .table-date {
        color: var(--primary);
        font-weight: 500;
    }
</style>
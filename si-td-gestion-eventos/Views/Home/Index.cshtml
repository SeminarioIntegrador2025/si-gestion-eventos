@{
    ViewData["Title"] = "Inicio";
}
<div>
    <div class="container-fluid">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h1 class="h4 mb-0">Panel general</h1>
            <div class="d-flex gap-2">
            </div>
        </div>

        <!-- KPIs -->
        <div class="row g-3">
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card card-kpi p-3">
                    <div class="card-title">Eventos del mes</div>
                    <div class="d-flex align-items-baseline gap-2">
                        <span class="display-6 fw-semibold">12</span>
                        <span class="text-success small"><i class="fa-solid fa-arrow-up-right me-1"></i>+3</span>
                    </div>
                    <div class="small text-muted">vs. mes anterior</div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card card-kpi p-3">
                    <div class="card-title">Ingresos (UYU)</div>
                    <div class="display-6 fw-semibold">$ 10.250</div>
                    <div class="small text-muted">Últimos 30 días</div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card card-kpi p-3">
                    <div class="card-title">Pagos pendientes</div>
                    <div class="display-6 fw-semibold">7</div>
                    <div class="small text-muted">A vencer esta semana</div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card card-kpi p-3">
                    <div class="card-title">Clientes activos</div>
                    <div class="display-6 fw-semibold">214</div>
                    <div class="small text-muted">Base actual</div>
                </div>
            </div>
        </div>

        <!-- Próximos eventos -->
        <div class="card mt-4">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <h2 class="h6 mb-0">Próximos eventos</h2>
                    <a class="btn btn-sm btn-outline-secondary" asp-controller="Evento" asp-action="Index">
                        Ver todos
                    </a>
                </div>
                <div class="table-responsive mt-3">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Cliente</th>
                                <th>Tipo</th>
                                <th>Personas</th>
                                <th>Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Ejemplos; reemplazar por tu modelo -->
                            <tr>
                                <td class="table-date">20/10 20:00</td>
                                <td>Martínez, Ana</td>
                                <td>Casamiento</td>
                                <td>120</td>
                                <td><span class="badge text-bg-warning">Reservado</span></td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-secondary" asp-controller="Evento" asp-action="Details" asp-route-id="1">
                                        <i class="fa-regular fa-eye"></i>
                                    </a>
                                    <a class="btn btn-sm btn-outline-secondary" asp-controller="Evento" asp-action="Edit" asp-route-id="1">
                                        <i class="fa-regular fa-pen-to-square"></i>
                                    </a>
                                </td>
                            </tr>
                            <tr>
                                <td class="table-date">28/10 18:00</td>
                                <td>Pérez, Juan</td>
                                <td>Cumpleaños</td>
                                <td>80</td>
                                <td><span class="badge text-bg-info">Confirmado</span></td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-secondary"><i class="fa-regular fa-eye"></i></a>
                                    <a class="btn btn-sm btn-outline-secondary"><i class="fa-regular fa-pen-to-square"></i></a>
                                </td>
                            </tr>
                            <tr>
                                <td class="table-date">02/11 21:00</td>
                                <td>Gómez, Lucía</td>
                                <td>Fiesta 15</td>
                                <td>150</td>
                                <td><span class="badge text-bg-success">Pagado</span></td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-secondary"><i class="fa-regular fa-eye"></i></a>
                                    <a class="btn btn-sm btn-outline-secondary"><i class="fa-regular fa-pen-to-square"></i></a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>


    <div class="text-center">
        <h1 class="display-4">Tata David - Fiestas y Eventos</h1>
        <p><i class="fa-solid fa-hashtag"></i> Redes: <a href="https://www.instagram.com/tata_david_?utm_source=ig_web_button_share_sheet&igsh=ZDNlZDc0MzIxNw=="> Instagram</a>.</p>
    </div>
</div>

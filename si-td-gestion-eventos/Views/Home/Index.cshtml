@using si_td_gestion_eventos.Models.ViewModels
@using si_td_gestion_eventos.Models.Enums

@{
    ViewData["Title"] = "Inicio";
    var reportes = ViewBag.Reportes as ReportesVM;
    var proximosEventos = ViewBag.ProximosEventos as List<EventoVM> ?? new List<EventoVM>();
    // Casteamos explícitamente para usar LINQ en la vista
    var alertas = ViewBag.AlertasServicios as List<EventoVM>;
}

<div>
    <div class="container-fluid">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h1 class="h4 mb-0">Panel general</h1>
            <div class="d-flex gap-2">
                <a class="btn btn-sm btn-primary" asp-controller="Reporte" asp-action="Index">
                    <i class="fa-solid fa-chart-line me-1"></i>
                    Ver reportes completos
                </a>
            </div>
        </div>

        @* --- SECCIÓN DE ALERTAS (CORREGIDA) --- *@
        @if (alertas != null && alertas.Any())
        {
            <div class="alert alert-danger border-danger shadow-sm mb-4">
                <div class="d-flex align-items-start">
                    <div class="me-3 mt-1">
                        <i class="fas fa-exclamation-triangle fa-2x text-white"></i>
                    </div>
                    <div class="flex-grow-1">

                        @* TÍTULO GENÉRICO (Ya no dice solo "Servicios") *@
                        <h4 class="alert-heading fs-5 fw-bold text-white">
                            ¡Atención! Eventos Próximos con Problemas
                        </h4>

                        <p class="mb-2 text-white small">
                            Los siguientes eventos comienzan en menos de 48hs y requieren acción inmediata (Deuda pendiente o Servicios sin verificar).
                        </p>

                        <div class="table-responsive bg-transparent rounded border border-danger-subtle">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="text-white border-bottom border-danger">
                                    <tr>
                                        <th>Cliente</th>
                                        <th>Tipo Evento</th>
                                        <th>Fecha Inicio</th>
                                        <th>Motivo de Alerta</th> @* NUEVA COLUMNA *@
                                        <th class="text-end">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var evento in alertas)
                                    {
                                        <tr class="text-white align-middle">
                                            <td class="fw-bold">@evento.ClienteNombreCompleto</td>
                                            <td>@evento.Tipo</td>
                                            <td>
                                                @evento.Inicio.ToString("dd/MM HH:mm")
                                                @if (evento.Estado == EventoEstado.Reprogramado)
                                                {
                                                    <span class="badge bg-info text-dark ms-1" style="font-size: 0.65rem;">Reprogramado</span>
                                                }
                                            </td>

                                            @* AQUÍ MOSTRAMOS LA RAZÓN REAL (DEUDA / SERVICIOS) *@
                                            <td class="text-warning fw-bold small">
                                                <i class="fa-solid fa-circle-exclamation me-1"></i>
                                                @evento.Observaciones
                                            </td>

                                            <td class="text-end">
                                                <a asp-controller="Evento" asp-action="Details" asp-route-id="@evento.EventoId"
                                                   class="btn btn-sm btn-light fw-bold border-0 text-danger">
                                                    <i class="fas fa-gear me-1"></i> Gestionar
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }

        @* --- SECCIÓN DE KPIs (MANTENIDA IGUAL) --- *@
        @if (reportes != null)
        {
            <div class="row g-3">
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card card-kpi p-3">
                        <div class="card-title">Eventos del mes</div>
                        <div class="d-flex align-items-baseline gap-2">
                            <span class="display-6 fw-semibold">@reportes.Eventos.EventosEsteMes</span>
                            @if (reportes.Eventos.CrecimientoPositivo)
                            {
                                <span class="text-success small">
                                    <i class="fa-solid fa-arrow-up-right me-1"></i>
                                    +@reportes.Eventos.PorcentajeCambioEventos%
                                </span>
                            }
                            else
                            {
                                <span class="text-danger small">
                                    <i class="fa-solid fa-arrow-down-right me-1"></i>
                                    @reportes.Eventos.PorcentajeCambioEventos%
                                </span>
                            }
                        </div>
                        <div class="small text-muted">vs. mes anterior (@reportes.Eventos.EventosMesAnterior)</div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card card-kpi p-3">
                        <div class="card-title">Ingresos recibidos (UYU)</div>
                        <div class="d-flex align-items-baseline gap-2">
                            <span class="display-6 fw-semibold">$ @reportes.Ingresos.TotalIngresosEsteMes.ToString("N0")</span>
                            @if (reportes.Ingresos.CrecimientoPositivo)
                            {
                                <span class="text-success small">
                                    <i class="fa-solid fa-arrow-up-right me-1"></i>
                                    +@reportes.Ingresos.PorcentajeCambioIngresos%
                                </span>
                            }
                            else
                            {
                                <span class="text-danger small">
                                    <i class="fa-solid fa-arrow-down-right me-1"></i>
                                    @reportes.Ingresos.PorcentajeCambioIngresos%
                                </span>
                            }
                        </div>
                        <div class="small text-muted">Este mes</div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card card-kpi p-3">
                        <div class="card-title">Adeudos pendientes</div>
                        <div class="display-6 fw-semibold text-warning">$ @reportes.Pagos.TotalAdeudado.ToString("N0")</div>
                        <div class="small text-muted">@reportes.Pagos.EventosConAdeudo evento(s) adeudado(s)</div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card card-kpi p-3">
                        <div class="card-title">Clientes activos</div>
                        <div class="display-6 fw-semibold">@reportes.Clientes.ClientesActivos</div>
                        <div class="small text-muted">Total: @reportes.Clientes.TotalClientes</div>
                    </div>
                </div>
            </div>
        }

        @* --- SECCIÓN PRÓXIMOS EVENTOS --- *@
        <div class="card mt-4 shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h2 class="h6 mb-0 fw-bold text-secondary">
                        <i class="fa-solid fa-calendar-days me-2 text-primary"></i>
                        Próximos eventos
                    </h2>
                    <a class="btn btn-sm btn-outline-secondary" asp-controller="Evento" asp-action="Index">
                        Ver todos <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                </div>

                @if (proximosEventos.Any())
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0 table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Fecha</th>
                                    <th>Cliente</th>
                                    <th>Tipo</th>
                                    <th class="text-center">Personas</th>
                                    <th class="text-center">Estado</th>
                                    <th class="text-end">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var evento in proximosEventos)
                                {
                                    // Lógica de color para el estado
                                    string estadoClass = evento.Estado switch
                                    {
                                        EventoEstado.PendientePagado => "bg-success",
                                        EventoEstado.PendienteAdeudado => "bg-warning text-dark",
                                        EventoEstado.Reprogramado => "bg-info text-dark",
                                        EventoEstado.Cancelado => "bg-danger",
                                        _ => "bg-secondary"
                                    };

                                    <tr>
                                        <td class="table-date">
                                            <strong>@evento.Inicio.ToString("dd/MM")</strong>
                                            <small class="d-block text-muted">@evento.HoraInicio?.ToString(@"hh\:mm")</small>
                                        </td>
                                        <td><strong>@evento.ClienteNombreCompleto</strong></td>
                                        <td><span class="badge bg-light text-dark border">@evento.Tipo</span></td>
                                        <td class="text-center">@evento.CantidadPersonas</td>
                                        <td class="text-center">
                                            <span class="badge @estadoClass">
                                                @evento.Estado
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <a class="btn btn-sm btn-outline-primary border-0" asp-controller="Evento" asp-action="Details" asp-route-id="@evento.EventoId" title="Ver detalles">
                                                <i class="fa-regular fa-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="fa-solid fa-calendar-xmark fa-2x mb-2"></i>
                        <p>No hay eventos próximos registrados.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
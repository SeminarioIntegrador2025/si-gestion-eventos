@using si_td_gestion_eventos.Models.ViewModels
@{
    ViewData["Title"] = "Inicio";
    var reportes = ViewBag.Reportes as ReportesVM;
    var proximosEventos = ViewBag.ProximosEventos as List<EventoVM> ?? new List<EventoVM>();
    var alertasAgadu = ViewBag.AlertasServicios as IEnumerable<EventoVM>;
}

<div>
    <div class="container-fluid">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h1 class="h4 mb-0">Panel general</h1>
            <div class="d-flex gap-2">
                <a class="btn btn-sm btn-primary" asp-controller="Reporte" asp-action="Index">
                    <i class="fa-solid fa-chart-line me-1"></i>
                    Ver reportes completos
                </a>
            </div>
        </div>

        @if (alertasAgadu != null && alertasAgadu.Any())
        {
            <div class="alert alert-danger border-danger shadow-sm mb-4">
                <div class="d-flex align-items-start">
                    <div class="me-3 mt-1">
                        <i class="fas fa-exclamation-triangle fa-2x text-white"></i>
                    </div>
                    <div class="flex-grow-1">
                        @* Cambiado a text-white para máximo contraste *@
                        <h4 class="alert-heading fs-5 fw-bold text-white">
                            ¡Acción Requerida! Faltan Servicios Esenciales
                        </h4>
                        @* Reemplazado text-dark por text-white *@
                        <p class="mb-2 text-white">
                            Los siguientes eventos comienzan en menos de 48hs y <strong>no tienen los servicios esenciales verificados</strong>.
                        </p>

                        <div class="table-responsive bg-transparent rounded border border-danger-subtle">
                            <table class="table table-sm table-hover mb-0">
                                @* Encabezados en blanco para que resalten sobre el fondo rojo *@
                                <thead class="text-white border-bottom border-danger">
                                    <tr>
                                        <th>Cliente</th>
                                        <th>Tipo Evento</th>
                                        <th>Fecha Inicio</th>
                                        <th class="text-end">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var evento in alertasAgadu)
                                    {
                                        <tr class="text-white">
                                            <td class="align-middle text-white">@evento.ClienteNombreCompleto</td>
                                            <td class="align-middle text-white">@evento.Tipo</td>
                                            @* Corregido: Formato de fecha sin hora y color blanco *@
                                            <td class="align-middle fw-bold text-white">
                                                @evento.Inicio.ToString("dd/MM/yyyy")
                                            </td>
                                            <td class="text-end">
                                                <a asp-controller="Evento" asp-action="Details" asp-route-id="@evento.EventoId"
                                                   class="btn btn-sm btn-outline-light me-1">
                                                    <i class="fas fa-eye"></i> Gestionar
                                                </a>

                                                <a asp-controller="Evento" asp-action="Cancel" asp-route-id="@evento.EventoId"
                                                   class="btn btn-sm btn-danger border-white text-white">
                                                    <i class="fas fa-ban me-1"></i> Cancelar
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }

        @* El resto del código de KPIs y Próximos Eventos se mantiene igual *@
        @if (reportes != null)
        {
            <div class="row g-3">
                @* ... (Bloques de KPIs sin cambios) ... *@
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card card-kpi p-3">
                        <div class="card-title">Eventos del mes</div>
                        <div class="d-flex align-items-baseline gap-2">
                            <span class="display-6 fw-semibold">@reportes.Eventos.EventosEsteMes</span>
                            @if (reportes.Eventos.CrecimientoPositivo)
                            {
                                <span class="text-success small">
                                    <i class="fa-solid fa-arrow-up-right me-1"></i>
                                    +@reportes.Eventos.PorcentajeCambioEventos%
                                </span>
                            }
                            else
                            {
                                <span class="text-danger small">
                                    <i class="fa-solid fa-arrow-down-right me-1"></i>
                                    @reportes.Eventos.PorcentajeCambioEventos%
                                </span>
                            }
                        </div>
                        <div class="small text-muted">vs. mes anterior (@reportes.Eventos.EventosMesAnterior)</div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card card-kpi p-3">
                        <div class="card-title">Ingresos recibidos (UYU)</div>
                        <div class="d-flex align-items-baseline gap-2">
                            <span class="display-6 fw-semibold">$ @reportes.Ingresos.TotalIngresosEsteMes.ToString("N0")</span>
                            @if (reportes.Ingresos.CrecimientoPositivo)
                            {
                                <span class="text-success small">
                                    <i class="fa-solid fa-arrow-up-right me-1"></i>
                                    +@reportes.Ingresos.PorcentajeCambioIngresos%
                                </span>
                            }
                            else
                            {
                                <span class="text-danger small">
                                    <i class="fa-solid fa-arrow-down-right me-1"></i>
                                    @reportes.Ingresos.PorcentajeCambioIngresos%
                                </span>
                            }
                        </div>
                        <div class="small text-muted">Este mes</div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card card-kpi p-3">
                        <div class="card-title">Adeudos pendientes</div>
                        <div class="display-6 fw-semibold text-warning">$ @reportes.Pagos.TotalAdeudado.ToString("N0")</div>
                        <div class="small text-muted">@reportes.Pagos.EventosConAdeudo evento(s) adeudado(s)</div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card card-kpi p-3">
                        <div class="card-title">Clientes activos</div>
                        <div class="display-6 fw-semibold">@reportes.Clientes.ClientesActivos</div>
                        <div class="small text-muted">Total: @reportes.Clientes.TotalClientes</div>
                    </div>
                </div>
            </div>
        }

        <div class="card mt-4">
            <div class="card-body">
                @* ... (Sección de Próximos Eventos) ... *@
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h2 class="h6 mb-0">
                        <i class="fa-solid fa-calendar-days me-2 text-primary"></i>
                        Próximos eventos
                    </h2>
                    <a class="btn btn-sm btn-outline-secondary" asp-controller="Evento" asp-action="Index">
                        Ver todos <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                </div>

                @if (proximosEventos.Any())
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Cliente</th>
                                    <th>Tipo</th>
                                    <th class="text-center">Personas</th>
                                    <th class="text-center">Estado</th>
                                    <th class="text-end">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var evento in proximosEventos)
                                {
                                    <tr>
                                        <td class="table-date">
                                            <strong>@evento.Inicio.ToString("dd/MM")</strong>
                                            <small class="d-block text-muted">@evento.HoraInicio?.ToString(@"hh\:mm")</small>
                                        </td>
                                        <td><strong>@evento.ClienteNombreCompleto</strong></td>
                                        <td><span class="badge bg-info-subtle text-info">@evento.Tipo</span></td>
                                        <td class="text-center">@evento.CantidadPersonas</td>
                                        <td class="text-center">
                                            @* Badge de estado con switch manual *@
                                            <span class="badge @(evento.Estado == si_td_gestion_eventos.Models.Enums.EventoEstado.PendientePagado ? "bg-success" : "bg-warning")">
                                                @evento.Estado
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <a class="btn btn-sm btn-outline-secondary" asp-controller="Evento" asp-action="Details" asp-route-id="@evento.EventoId">
                                                <i class="fa-regular fa-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
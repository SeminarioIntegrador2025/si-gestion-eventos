@using si_td_gestion_eventos.Models.ViewModels
@model List<ClienteVM>

@{
    ViewData["Title"] = "Clientes - Gestión";
}

<!-- Encabezado de página -->
<div class="page-header d-flex align-items-start justify-content-between flex-wrap gap-3">
    <div>
        <h1 class="page-title mb-1">
            <i class="fa-solid fa-users text-primary me-3"></i>Gestion de Clientes
        </h1>
    </div>

    <!-- Acciones a la derecha -->
    <div class="ms-auto d-flex gap-2">
        <a class="btn btn-success" asp-action="Create">
            <i class="fa-solid fa-user-plus me-2"></i>Nuevo Cliente
        </a>
        <div class="dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                <i class="fa-solid fa-download me-2"></i>Exportar
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" asp-action="ExportExcel"><i class="fa-solid fa-file-excel me-2"></i>Excel</a></li>
                <li><a class="dropdown-item" asp-action="ExportCsv"><i class="fa-solid fa-file-csv me-2"></i>CSV</a></li>
            </ul> 
            <!-- Ajustar Formatos -->
        </div>
    </div>
</div>

<!-- GRID: 3/4 tabla + 1/4 panel derecho -->
<div class="row g-4">
    <!-- Área principal (≈ 3/4) -->
    <div class="col-xl-9 col-lg-8">
        <!-- KPIs -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card card-kpi text-center">
                    <div class="card-body">
                        <div class="card-title mb-1">Total Clientes</div>
                        <div class="display-6 text-primary fw-bold">@Model.Count</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-kpi text-center">
                    <div class="card-body">
                        <div class="card-title mb-1">Activos</div>
                        <div class="display-6 text-success fw-bold">@Model.Count(c => c.Activo)</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-kpi text-center">
                    <div class="card-body">
                        <div class="card-title mb-1">Inactivos</div>
                        <div class="display-6 text-warning fw-bold">@Model.Count(c => !c.Activo)</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filtros -->
        <div class="card mb-4">
            <div class="card-body">
                <form method="get" class="row g-3 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label fw-semibold">
                            <i class="fa-solid fa-magnifying-glass me-1"></i>Buscar Cliente
                        </label>
                        <input name="q" class="form-control" placeholder="Nombre, apellido, cédula o teléfono..." />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">
                            <i class="fa-solid fa-filter me-1"></i>Estado
                        </label>
                        <select name="estado" class="form-select">
                            <option value="">Todos</option>
                            <option value="activo">Solo activos</option>
                            <option value="inactivo">Solo inactivos</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-semibold">Mostrar</label>
                        <select name="pageSize" class="form-select" onchange="this.form.submit()">
                            @{
                                int[] sizes = new[] { 10, 25, 50, 100 };
                                foreach (var s in sizes)
                                {
                                    <option value="@s">@s por página</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fa-solid fa-search me-1"></i>Buscar
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Tabla -->
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="fa-solid fa-table me-2"></i>Lista de Clientes</span>
                <span class="badge bg-primary">@Model.Count clientes</span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th><i class="fa-solid fa-user me-1"></i>Cliente</th>
                            <th>
                                <i class="fa-solid fa-id-card me-1"></i>Documento (CI/RUT)
                            </th>
                            <th><i class="fa-solid fa-phone me-1"></i>Teléfono</th>
                            <th><i class="fa-solid fa-building-user me-1"></i>Tipo</th>
                            <th><i class="fa-solid fa-toggle-on me-1"></i>Estado</th>
                            <th class="text-center"><i class="fa-solid fa-cog me-1"></i>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var cliente in Model)
                            {
                                <tr class="@(!cliente.Activo ? "table-secondary" : "")">
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-md @(cliente.Activo ? "bg-primary" : "bg-secondary") text-white rounded-circle d-flex align-items-center justify-content-center me-3">
                                                @(cliente.Nombre.Substring(0, 1) + (cliente.Apellido != null ? cliente.Apellido.Substring(0, 1) : ""))
                                            </div>
                                            <div>
                                                <div class="fw-semibold">@(cliente.Apellido != null ? $"{cliente.Apellido}, {cliente.Nombre}" : cliente.Nombre)</div>
                                                <small class="text-muted">Cliente @(cliente.Activo ? "activo" : "inactivo")</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="font-monospace">
                                            @if (cliente.Tipo == si_td_gestion_eventos.Models.Enums.TipoCliente.PersonaFisica)
                                            {
                                                @cliente.CedulaIdentidad
                                            }
                                            else
                                            {
                                                @cliente.RUT
                                            }
                                        </span>
                                    </td>
                                    <td>
                                        <a href="tel:@cliente.Telefono" class="text-decoration-none">
                                            <i class="fa-solid fa-phone me-1 text-success"></i>@cliente.Telefono
                                        </a>
                                    </td>
                                    <td>
                                        @if (cliente.Tipo == si_td_gestion_eventos.Models.Enums.TipoCliente.PersonaFisica)
                                        {
                                            <span title="Persona Física"><i class="fa-solid fa-user text-info me-1"></i> Física</span>
                                        }
                                        else
                                        {
                                            <span title="Persona Jurídica"><i class="fa-solid fa-building text-warning me-1"></i> Jurídica</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @(cliente.Activo ? "bg-success" : "bg-secondary")">
                                            <i class="fa-solid fa-@(cliente.Activo ? "check" : "times") me-1"></i>
                                            @(cliente.Activo ? "Activo" : "Inactivo")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@cliente.ClienteId" class="btn btn-sm btn-outline-info" title="Ver detalles">
                                                <i class="fa-solid fa-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@cliente.ClienteId" class="btn btn-sm btn-outline-secondary" title="Editar">
                                                <i class="fa-solid fa-pen"></i>
                                            </a>
                                         @* No aplica las validaciones para crear un evento (Cliente Activo) y en todo caso deberia crear el evento con el cliente ya seleccionado
                                             <a asp-controller="Evento" asp-action="Create" asp-route-clienteId="@cliente.ClienteId" class="btn btn-sm btn-outline-success" title="Crear evento">
                                                <i class="fa-solid fa-calendar-plus"></i>
                                            </a> *@
                                            @if (@cliente.Activo)
                                            {
                                                <form asp-action="ToggleUnactive" asp-route-id="@cliente.ClienteId" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-danger" onclick="return confirm('¿Está seguro que desea dar de baja este cliente?');">
                                                        Dar de baja
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="ToggleActive" asp-route-id="@cliente.ClienteId" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-success" onclick="return confirm('¿Desea dar de alta este cliente?');">
                                                        Dar de alta
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <div class="text-muted">
                                        <i class="fa-solid fa-user-slash fa-3x mb-3 d-block"></i>
                                        <h5>No se encontraron clientes</h5>
                                        <p>
                                            Intenta ajustar los filtros o
                                            <a asp-action="Create" class="text-decoration-none">agregar un nuevo cliente</a>.
                                        </p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Sidebar derecho (≈ 1/4) -->
    <div class="col-xl-3 col-lg-4">
        <!-- Últimos 5 clientes agregados (datos reales) -->
        <div class="card mb-4">
            <div class="card-header d-flex align-items-center justify-content-between">
                <span><i class="fa-solid fa-clock-rotate-left me-2"></i>Últimos clientes</span>
                <a asp-action="Create" class="btn btn-sm btn-accent"><i class="fa-solid fa-user-plus me-1"></i>Nuevo</a>
            </div>
            <div class="list-group list-group-flush">
                @foreach (var c in Model.OrderByDescending(x => x.ClienteId).Take(5))
                {
                    <a class="list-group-item list-group-item-action d-flex align-items-center justify-content-between"
                       asp-action="Details" asp-route-id="@c.ClienteId">
                        <div class="d-flex align-items-center">
                            <div class="avatar-sm bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center me-3">
                                @(c.Nombre.Substring(0, 1) + (c.Apellido != null ? c.Apellido.Substring(0, 1) : ""))
                            </div>
                            <div>
                                <div class="fw-semibold">@(c.Apellido != null ? $"{c.Apellido}, {c.Nombre}" : c.Nombre)</div>
                                <small class="text-muted">@c.CedulaIdentidad</small>
                            </div>
                        </div>
                        <i class="fa-solid fa-chevron-right text-muted"></i>
                    </a>
                }
            </div>
        </div>

        <!-- Estadísticas rápidas -->
        <div class="card">
            <div class="card-header">
                <i class="fa-solid fa-chart-pie me-2"></i>Estadísticas
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-6">
                        <div class="text-center">
                            <div class="h4 text-primary mb-0">@(Model.Any() ? Math.Round((double)Model.Count(c => c.Activo) / Model.Count * 100, 1) : 0)%</div>
                            <small class="text-muted">Activos</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="text-center">
                            <div class="h4 text-primary mb-0">@(Model.Any() ? Math.Round((double)Model.Count(c => c.Tipo == si_td_gestion_eventos.Models.Enums.TipoCliente.PersonaFisica) / Model.Count * 100, 1) : 0)%</div>
                            <small class="text-muted">Física</small>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="text-center">
                            <div class="h4 text-primary mb-0">@(Model.Any() ? Math.Round((double)Model.Count(c => c.Tipo == si_td_gestion_eventos.Models.Enums.TipoCliente.PersonaJuridica) / Model.Count * 100, 1) : 0)%</div>
                            <small class="text-muted">Juridica</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

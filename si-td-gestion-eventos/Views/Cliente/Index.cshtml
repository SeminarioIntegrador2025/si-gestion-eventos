@using si_td_gestion_eventos.Models.ViewModels
@model si_td_gestion_eventos.Infrastructure.PaginatedList<ClienteVM>

@{
    ViewData["Title"] = "Clientes - Gestión";

    string q = Context.Request.Query["q"];
    string estado = Context.Request.Query["estado"];
    int pageSize = int.TryParse(Context.Request.Query["pageSize"], out var ps) ? ps : 10;
}

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Ok"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Encabezado de página -->
<div class="page-header d-flex align-items-start justify-content-between flex-wrap gap-3">
    <div>
        <h1 class="page-title mb-1">
            <i class="fa-solid fa-users text-primary me-3"></i>Gestión de Clientes
        </h1>
    </div>

    <!-- Acciones a la derecha - ✅ REMOVIDO BOTÓN EXPORTAR -->
    <div class="ms-auto d-flex gap-2">
        <a class="btn btn-success" asp-action="Create">
            <i class="fa-solid fa-user-plus me-2"></i>Nuevo Cliente
        </a>
    </div>
</div>

<!-- GRID: 3/4 tabla + 1/4 panel derecho -->
<div class="row g-4">
    <!-- Área principal (≈ 3/4) -->
    <div class="col-xl-9 col-lg-8">

        <!-- KPIs (con lo que hay en la página, y total con TotalCount) -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card card-kpi text-center">
                    <div class="card-body">
                        <div class="card-title mb-1">Total Clientes</div>
                        <div class="display-6 text-primary fw-bold">@Model.TotalCount</div>
                        <small class="text-muted">Mostrando @Model.Count de @Model.TotalCount</small>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card card-kpi text-center">
                <div class="card-body">
                    <div class="card-title mb-1">Activos (página)</div>
                    <div class="display-6 text-success fw-bold">@Model.Count(c => c.Activo)</div>
                </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card card-kpi text-center">
                <div class="card-body">
                    <div class="card-title mb-1">Inactivos (página)</div>
                    <div class="display-6 text-warning fw-bold">@Model.Count(c => !c.Activo)</div>
                </div>
                </div>
            </div>
        </div>

        <!-- Filtros -->
        <div class="card mb-4">
            <div class="card-body">
                <form method="get" class="row g-3 align-items-end">
                    <input type="hidden" name="page" value="1" />

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            <i class="fa-solid fa-magnifying-glass me-1"></i>Buscar Cliente
                        </label>
                        <input name="q" class="form-control"
                               value="@q"
                               placeholder="Nombre, apellido, cédula o teléfono..." />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold">
                            <i class="fa-solid fa-filter me-1"></i>Estado
                        </label>
                        <select name="estado" class="form-select">
                            <option value="" selected="@(string.IsNullOrEmpty(estado))">Todos</option>
                            <option value="activo" selected="@(estado == "activo")">Solo activos</option>
                            <option value="inactivo" selected="@(estado == "inactivo")">Solo inactivos</option>
                        </select>
                    </div>

                    @* ✅ FIX: Quitar "por página" del texto *@
                    <div class="col-md-1">
                        <label class="form-label fw-semibold">Mostrar</label>
                        <select name="pageSize" class="form-select" onchange="this.form.submit()">
                            @foreach (var s in new[] { 10, 25, 50 })
                            {
                                <option value="@s" selected="@(s == pageSize)">@s</option>
                            }
                        </select>
                    </div>

                    @* ✅ FIX: Añadir botón limpiar filtros *@
                    <div class="col-md-4 d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-fill">
                            <i class="fa-solid fa-search me-1"></i>
                            <span class="d-none d-lg-inline">Buscar</span>
                        </button>
                        <a class="btn btn-outline-secondary flex-shrink-0" 
                           asp-action="Index"
                           asp-route-page="1"
                           asp-route-pageSize="@pageSize"
                           title="Limpiar filtros"
                           aria-label="Limpiar filtros"
                           style="min-width: 42px;">
                            <i class="fa-solid fa-rotate-left"></i>
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Tabla -->
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="fa-solid fa-table me-2"></i>Lista de Clientes</span>
                <span class="badge bg-primary">@Model.TotalCount clientes</span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th><i class="fa-solid fa-user me-1"></i>Cliente</th>
                            <th><i class="fa-solid fa-id-card me-1"></i>Documento (CI/RUT)</th>
                            <th><i class="fa-solid fa-phone me-1"></i>Teléfono</th>
                            <th><i class="fa-solid fa-building-user me-1"></i>Tipo</th>
                            <th><i class="fa-solid fa-toggle-on me-1"></i>Estado</th>
                            <th class="text-center"><i class="fa-solid fa-cog me-1"></i>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var cliente in Model)
                            {
                                <tr class="@(!cliente.Activo ? "table-secondary" : "")">
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-md @(cliente.Activo ? "bg-primary" : "bg-secondary") text-white rounded-circle d-flex align-items-center justify-content-center me-3">
                                                @(cliente.Nombre.Substring(0, 1) + (cliente.Apellido != null ? cliente.Apellido.Substring(0, 1) : ""))
                                            </div>
                                            <div>
                                                <div class="fw-semibold">@(cliente.Apellido != null ? $"{cliente.Apellido}, {cliente.Nombre}" : cliente.Nombre)</div>
                                                <small class="text-muted">Cliente @(cliente.Activo ? "activo" : "inactivo")</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="font-monospace">
                                            @if (cliente.Tipo == si_td_gestion_eventos.Models.Enums.TipoCliente.PersonaFisica)
                                            {
                                                @cliente.CedulaIdentidad
                                            }
                                            else
                                            {
                                                @cliente.RUT
                                            }
                                        </span>
                                    </td>
                                    <td>
                                        <a href="tel:@cliente.Telefono" class="text-decoration-none">
                                            <i class="fa-solid fa-phone me-1 text-success"></i>@cliente.Telefono
                                        </a>
                                    </td>
                                    <td>
                                        @if (cliente.Tipo == si_td_gestion_eventos.Models.Enums.TipoCliente.PersonaFisica)
                                        {
                                            <span title="Persona Física"><i class="fa-solid fa-user text-info me-1"></i> Física</span>
                                        }
                                        else
                                        {
                                            <span title="Persona Jurídica"><i class="fa-solid fa-building text-warning me-1"></i> Jurídica</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @(cliente.Activo ? "bg-success" : "bg-secondary")">
                                            <i class="fa-solid fa-@(cliente.Activo ? "check" : "times") me-1"></i>
                                            @(cliente.Activo ? "Activo" : "Inactivo")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@cliente.ClienteId" class="btn btn-sm btn-outline-info" title="Ver detalles">
                                                <i class="fa-solid fa-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@cliente.ClienteId" class="btn btn-sm btn-outline-secondary" title="Editar">
                                                <i class="fa-solid fa-pen"></i>
                                            </a>

                                            @if (cliente.Activo)
                                            {
                                                <form asp-action="ToggleUnactive" method="post" class="d-inline"
                                                      onsubmit="return confirm('¿Está seguro que desea dar de baja este cliente?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@cliente.ClienteId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Dar de Baja">
                                                        <i class="fa-solid fa-ban"></i>
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="ToggleActive" method="post" class="d-inline"
                                                      onsubmit="return confirm('¿Desea dar de alta este cliente?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@cliente.ClienteId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Dar de Alta">
                                                        <i class="fa-solid fa-check"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <div class="text-muted">
                                        <i class="fa-solid fa-user-slash fa-3x mb-3 d-block"></i>
                                        <h5>No se encontraron clientes</h5>
                                        <p>
                                            Intenta ajustar los filtros o
                                            <a asp-action="Create" class="text-decoration-none">agregar un nuevo cliente</a>.
                                        </p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
    <small class="text-muted">
        Página @Model.PageIndex de @Model.TotalPages (@Model.TotalCount resultados)
    </small>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Paginación">
            <ul class="pagination mb-0">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-q="@q"
                       asp-route-estado="@estado"
                       asp-route-page="@(Model.PageIndex - 1)"
                       asp-route-pageSize="@pageSize">
                        <i class="fas fa-chevron-left me-1"></i>Anterior
                    </a>
                </li>

                @for (int i = Model.StartPage; i <= Model.EndPage; i++)
                {
                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-q="@q"
                           asp-route-estado="@estado"
                           asp-route-page="@i"
                           asp-route-pageSize="@pageSize">@i</a>
                    </li>
                }

                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-q="@q"
                       asp-route-estado="@estado"
                       asp-route-page="@(Model.PageIndex + 1)"
                       asp-route-pageSize="@pageSize">
                        Siguiente<i class="fas fa-chevron-right ms-1"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>
        </div>
    </div>

    <!-- Sidebar derecho (≈ 1/4) -->
    <div class="col-xl-3 col-lg-4">
        <div class="card mb-4">
            <div class="card-header d-flex align-items-center justify-content-between">
                <span><i class="fa-solid fa-clock-rotate-left me-2"></i>Últimos clientes</span>
                <a asp-action="Create" class="btn btn-sm btn-accent"><i class="fa-solid fa-user-plus me-1"></i>Nuevo</a>
            </div>
            <div class="list-group list-group-flush">
                @foreach (var c in Model.OrderByDescending(x => x.ClienteId).Take(5))
                {
                    <a class="list-group-item list-group-item-action d-flex align-items-center justify-content-between"
                       asp-action="Details" asp-route-id="@c.ClienteId">
                        <div class="d-flex align-items-center">
                            <div class="avatar-sm bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center me-3">
                                @(c.Nombre.Substring(0, 1) + (c.Apellido != null ? c.Apellido.Substring(0, 1) : ""))
                            </div>
                            <div>
                                <div class="fw-semibold">@(c.Apellido != null ? $"{c.Apellido}, {c.Nombre}" : c.Nombre)</div>
                                <small class="text-muted">@c.CedulaIdentidad</small>
                            </div>
                        </div>
                        <i class="fa-solid fa-chevron-right text-muted"></i>
                    </a>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <i class="fa-solid fa-chart-pie me-2"></i>Estadísticas
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-6">
                        <div class="text-center">
                            <div class="h4 text-primary mb-0">@(Model.Any() ? Math.Round((double)Model.Count(c => c.Activo) / Model.Count * 100, 1) : 0)%</div>
                            <small class="text-muted">Activos (página)</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="text-center">
                            <div class="h4 text-primary mb-0">@(Model.Any() ? Math.Round((double)Model.Count(c => c.Tipo == si_td_gestion_eventos.Models.Enums.TipoCliente.PersonaFisica) / Model.Count * 100, 1) : 0)%</div>
                            <small class="text-muted">Física (página)</small>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="text-center">
                            <div class="h4 text-primary mb-0">@(Model.Any() ? Math.Round((double)Model.Count(c => c.Tipo == si_td_gestion_eventos.Models.Enums.TipoCliente.PersonaJuridica) / Model.Count * 100, 1) : 0)%</div>
                            <small class="text-muted">Jurídica (página)</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

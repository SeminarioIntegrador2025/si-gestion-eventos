@model List<ClienteVM>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="m-0">Lista de todos los clientes</h2>
    <a class="btn btn-primary" asp-action="Create"><i class="fa-solid fa-square-plus"></i>Nuevo Cliente</a>
</div>

<div class="row">
    <div class="col-md-8">
        <form method="get" class="row g-2 mb-3">
            <div class="col-sm-8">
              
            </div>
            <div class="col-sm-2">
                <select name="pageSize" class="form-select" onchange="this.form.submit()">
                    @{
                        int[] sizes = new[] { 5, 10, 20, 50 };
                        foreach (var s in sizes)
                        {
                         
                        }
                    }
                </select>
            </div>
            <div class="col-sm-2">
                <button type="submit" class="btn btn-outline-secondary w-100"><i class="fa-solid fa-magnifying-glass"></i>Buscar</button>
            </div>
        </form>

        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Apellido</th>
                    <th>Nombre</th>
                    <th>Cédula</th>
                    <th>Teléfono</th>
                    <th>Activo</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.Apellido</td>
                        <td>@c.Nombre</td>
                        <td>@c.CedulaIdentidad</td>
                        <td>@c.Telefono</td>
                        <td>@(c.Activo ? "Sí" : "No")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@c.ClienteId" class="btn btn-sm btn-outline-info"><i class="fa-solid fa-eye"></i>Ver</a>
                            <a asp-action="Edit" asp-route-id="@c.ClienteId" class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-pen"></i>Editar</a>
                            <a asp-action="Delete" asp-route-id="@c.ClienteId" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-delete-left"></i>Borrar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table> 
</div>

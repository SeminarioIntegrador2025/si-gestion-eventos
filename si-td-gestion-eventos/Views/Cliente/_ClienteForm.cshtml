@model si_td_gestion_eventos.Models.ViewModels.ClienteVM

<div>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Apellido" class="form-label"></label>
        <input asp-for="Apellido" class="form-control" />
        <span asp-validation-for="Apellido" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CedulaIdentidad" class="form-label"></label>
        <input asp-for="CedulaIdentidad" class="form-control" />
        <span asp-validation-for="CedulaIdentidad" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Domicilio" class="form-label"></label>
        <input asp-for="Domicilio" class="form-control" />
        <span asp-validation-for="Domicilio" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Telefono" class="form-label"></label>
        <input asp-for="Telefono" class="form-control" />
        <span asp-validation-for="Telefono" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Activo" class="form-label"></label>
        <input asp-for="Activo" type="checkbox" class="form-check-input" />
        <span asp-validation-for="Activo" class="text-danger"></span>
    </div>

</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

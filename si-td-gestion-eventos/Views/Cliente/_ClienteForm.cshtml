@model si_td_gestion_eventos.Entities.Cliente

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="mb-3">
    <label asp-for="Nombre" class="form-label"></label>
    <input asp-for="Nombre" class="form-control" />
    <span asp-validation-for="Nombre" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Apellido" class="form-label"></label>
    <input asp-for="Apellido" class="form-control" />
    <span asp-validation-for="Apellido" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="CedulaIdentidad" class="form-label"></label>
    <input asp-for="CedulaIdentidad" class="form-control" />
    <span asp-validation-for="CedulaIdentidad" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Domicilio" class="form-label"></label>
    <input asp-for="Domicilio" class="form-control" />
    <span asp-validation-for="Domicilio" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Telefono" class="form-label"></label>
    <input asp-for="Telefono" class="form-control" />
    <span asp-validation-for="Telefono" class="text-danger"></span>
</div>

<div class="form-check mb-3">
    <input class="form-check-input" asp-for="Activo" />
    <label class="form-check-label" asp-for="Activo"></label>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

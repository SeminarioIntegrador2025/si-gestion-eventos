@using si_td_gestion_eventos.Models.ViewModels
@using si_td_gestion_eventos.Models.Enums
@model ClienteVM

@{
    ViewData["Title"] = "Detalles del Cliente";
    
    //   Determinar color de estado
    string estadoBadgeClass = Model.Activo ? "bg-success" : "bg-danger";
    string estadoTexto = Model.Activo ? "Activo" : "Inactivo";
    string estadoIcono = Model.Activo ? "fa-check-circle" : "fa-ban";
}

<div class="container-fluid">
    @* ENCABEZADO *@
    <div class="page-header mb-4 d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <h2 class="page-title mb-2">
                <i class="fa-solid fa-user-circle me-2 text-primary"></i>
                Detalles del Cliente
            </h2>
            <p class="text-muted mb-0">
                <i class="fa-solid fa-id-card me-1"></i>
                @Model.CedulaIdentidad
            </p>
        </div>
        
        @*   Badge de estado visual *@
        <div>
            <span class="badge @estadoBadgeClass fs-5 px-3 py-2">
                <i class="fa-solid @estadoIcono me-2"></i>@estadoTexto
            </span>
        </div>
    </div>

    <div class="row g-4">
        @* COLUMNA PRINCIPAL *@
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-header bg-light border-bottom">
                    <h5 class="mb-0">
                        <i class="fa-solid fa-info-circle me-2 text-primary"></i>Información General
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-4">
                        @* COLUMNA IZQUIERDA *@
                        <div class="col-md-6 border-end">
                            <div class="mb-4">
                                <label class="text-muted small mb-1">
                                    <i class="fa-solid fa-user me-1"></i>
                                    @if (Model.Tipo == TipoCliente.PersonaFisica)
                                    {
                                        <span>Nombre Completo</span>
                                    }
                                    else
                                    {
                                        <span>Razón Social</span>
                                    }
                                </label>
                                <p class="fs-5 fw-bold mb-0">
                                    @if (Model.Tipo == TipoCliente.PersonaFisica)
                                    {
                                        <span>@Model.Nombre @Model.Apellido</span>
                                    }
                                    else
                                    {
                                        <span>@Model.Nombre</span>
                                    }
                                </p>
                            </div>

                            <div class="mb-4">
                                <label class="text-muted small mb-1">
                                    <i class="fa-solid fa-building me-1"></i>Tipo de Cliente
                                </label>
                                <p class="mb-0">
                                    <span class="badge bg-info">
                                        @Html.DisplayFor(m => m.Tipo)
                                    </span>
                                </p>
                            </div>

                            <div class="mb-0">
                                <label class="text-muted small mb-1">
                                    <i class="fa-solid fa-id-card me-1"></i>
                                    @if (Model.Tipo == TipoCliente.PersonaFisica)
                                    {
                                        <span>Cédula de Identidad</span>
                                    }
                                    else
                                    {
                                        <span>RUT</span>
                                    }
                                </label>
                                <p class="fs-6 mb-0 font-monospace">@Model.CedulaIdentidad</p>
                            </div>
                        </div>

                        @* COLUMNA DERECHA *@
                        <div class="col-md-6">
                            <div class="mb-4">
                                <label class="text-muted small mb-1">
                                    <i class="fa-solid fa-phone me-1"></i>Teléfono
                                </label>
                                <p class="fs-6 mb-0">
                                    <a href="tel:@Model.Telefono" class="text-decoration-none">
                                        <i class="fa-brands fa-whatsapp text-success me-1"></i>
                                        @Model.Telefono
                                    </a>
                                </p>
                            </div>

                            <div class="mb-4">
                                <label class="text-muted small mb-1">
                                    <i class="fa-solid fa-location-dot me-1"></i>Domicilio
                                </label>
                                <p class="mb-0">@Model.Domicilio</p>
                            </div>

                            <div class="mb-0">
                                <label class="text-muted small mb-1">
                                    <i class="fa-solid fa-toggle-on me-1"></i>Estado
                                </label>
                                <p class="mb-0">
                                    @if (Model.Activo)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success px-3 py-2">
                                            <i class="fa-solid fa-check-circle me-1"></i>Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger px-3 py-2">
                                            <i class="fa-solid fa-ban me-1"></i>Inactivo
                                        </span>
                                    }
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* SIDEBAR ACCIONES *@
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-header bg-primary text-white">
                    <h6 class="mb-0">
                        <i class="fa-solid fa-toolbox me-2"></i>Acciones
                    </h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.ClienteId" class="btn btn-primary">
                            <i class="fa-solid fa-pen me-2"></i>Editar Información
                        </a>

                        @if (Model.Activo)
                        {
                            <form asp-action="ToggleUnactive" asp-route-id="@Model.ClienteId" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger w-100" 
                                        onclick="return confirm('⚠️ ¿Está seguro de dar de baja este cliente?\n\nNo podrá crear nuevos eventos con este cliente mientras esté inactivo.');">
                                    <i class="fa-solid fa-user-slash me-2"></i>Dar de Baja
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="ToggleActive" asp-route-id="@Model.ClienteId" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-success w-100" 
                                        onclick="return confirm('  ¿Desea reactivar este cliente?');">
                                    <i class="fa-solid fa-user-check me-2"></i>Dar de Alta
                                </button>
                            </form>
                        }

                        <hr class="my-2" />

                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fa-solid fa-arrow-left me-2"></i>Volver al Listado
                        </a>
                    </div>
                </div>
            </div>

            @* TARJETA INFORMATIVA *@
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light">
                    <h6 class="mb-0 text-muted">
                        <i class="fa-solid fa-lightbulb me-2"></i>Información
                    </h6>
                </div>
                <div class="card-body">
                    <p class="small text-muted mb-0">
                        <i class="fa-solid fa-info-circle me-1"></i>
                        Los clientes inactivos no pueden ser seleccionados al crear nuevos eventos.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

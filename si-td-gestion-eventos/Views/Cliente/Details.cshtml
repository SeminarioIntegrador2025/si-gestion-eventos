@using si_td_gestion_eventos.Models.ViewModels
@model ClienteVM
@{
    var title = "Detalle del cliente: ";
}

<h2>@title</h2>
<dl class="row">
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Nombre</dd>

    @if (Model.Tipo == si_td_gestion_eventos.Models.Enums.TipoCliente.PersonaFisica)
    {
        <dt class="col-sm-3">Apellido</dt>
        <dd class="col-sm-9">@Model.Apellido</dd>
    }

    <dt class="col-sm-3">Tipo de Cliente</dt>
    @if (Model.Tipo == si_td_gestion_eventos.Models.Enums.TipoCliente.PersonaFisica)
    {
        <dd class="col-sm-9">Persona Fisica</dd>
    }
    else
    {
        <dd class="col-sm-9">Persona Juridica</dd>
    }

    <dt class="col-sm-3">Cédula</dt>
    <dd class="col-sm-9">@Model.CedulaIdentidad</dd>

    <dt class="col-sm-3">Domicilio</dt>
    <dd class="col-sm-9">@Model.Domicilio</dd>

    <dt class="col-sm-3">Teléfono</dt>
    <dd class="col-sm-9">@Model.Telefono</dd>

    <dt class="col-sm-3">Activo</dt>
    <dd class="col-sm-9">
        @if (Model.Activo)
        {
            <i class="fa-solid fa-check text-success"></i>
            <span class="text-success">Sí</span>
        }
        else
        {
            <i class="fa-solid fa-xmark text-danger"></i>
            <span class="text-danger">No</span>
        }
    </dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.ClienteId" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Volver</a>


@if (Model.Activo)
{
    <form asp-action="ToggleUnactive" asp-route-id="@Model.ClienteId" method="post" class="d-inline">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger" onclick="return confirm('¿Está seguro que desea dar de baja este cliente?');">
            Dar de baja
        </button>
    </form>
}
else
{
    <form asp-action="ToggleActive" asp-route-id="@Model.ClienteId" method="post" class="d-inline">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-success" onclick="return confirm('¿Desea dar de alta este cliente?');">
            Dar de alta
        </button>
    </form>
}
